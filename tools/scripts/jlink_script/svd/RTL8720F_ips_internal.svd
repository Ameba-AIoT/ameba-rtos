              <name>CTRL_RATE_REP_TIME_4TH</name>
              <description>RTA_CTS2S
indicate the number of repetitions of the rate after 3rd rate fallback
0: repeat 1 time
1: repeat 2 times
2: repeat 4 times
3: repeat 8 times
4: repeat 16 times</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTRL_RATE_REP_TIME_3RD</name>
              <description>RTS/CTS2S
