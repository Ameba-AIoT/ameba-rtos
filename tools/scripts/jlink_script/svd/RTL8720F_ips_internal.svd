          <addressOffset>0x000002E8</addressOffset>
          <size>32</size>
          <description>Status for IntTfr Interrupt</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
