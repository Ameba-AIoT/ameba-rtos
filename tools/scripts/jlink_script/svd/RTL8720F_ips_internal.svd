              <access>read-write</access>
            </field>
            <field protection="s">
              <name>plfm1_sys_rst</name>
              <description>Only when REG_SW_RST_TRIG is 0x96969696 , this reg can be write</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>srst1_glb_rst_en</name>
              <description>1.system reset1  will reset all syson IP and local CPU1(km4ns)
0.system reset0  will reset local CPU1(km4ns)</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>srst0_glb_rst_en</name>
              <description>1.system reset0  will reset all syson IP and local CPU0(km4tz)
0.system reset0  will reset local CPU0(km4tz)</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>sys_glbrst_timeout</name>
              <description>If system glb rst en is disable , system reset will reset its local cpu only . but if bus is hang , it will trigger global reset also . 
HW will wait local CPU's status , if it is not in IDLE in a threshold time, it will trigger global reset .
Note : This value must set &gt; 1 , it is base on 4M clock cycle .</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>wdg_glbrst_timeout</name>
              <description>If wdg's glb rst en is disable , wdg reset will reset its local cpu only . but if bus is hang , it will trigger global reset also . 
HW will wait local CPU's status , if it is not in IDLE in a threshold time, it will trigger global reset .
Note : This value must set &gt; 1 , it is base on 32k clock cycle .</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>wdg2_glb_rst_en</name>
              <description>1.wdg2 will reset all syson IP and local CPU
0.wdg2 will reset local CPU and itself
Note: wdg2 's local CPU is CPU0</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>wdg1_glb_rst_en</name>
              <description>1.wdg1 will reset all syson IP and local CPU
0.wdg1 will reset local CPU and itself
Note: wdg1 's local CPU is CPU0</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>wdg0_glb_rst_en</name>
              <description>1.wdg0 will reset all syson IP and local CPU
0.wdg0 will reset local CPU and itself
Note: wdg0 's local CPU is CPU1</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>periall_rst_en</name>
              <description>1. warm reset request by one cpu will reset all peri and local cpu
0. warm reset request by one cpu will only reset local cpu
Note : peri rst will use sysrst mst also</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field protection="s">
              <name>othercpu_rst_en</name>
              <description>1. warm reset request by one cpu will reset other cpu's core and local cpu
0. warm reset request by one cpu will only reset local cpu</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
