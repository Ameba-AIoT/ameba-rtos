              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>1: I3C/I2C transaction is still busy
0: I3C/I2C transaction is NOT busy (Idle)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
