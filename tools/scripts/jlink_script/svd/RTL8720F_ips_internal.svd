              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>C_C2</name>
              <description>Controller counter from the first SCL positive-going edge after the IBI ACK to the first SCL positive-going edge after the T-Bit of the IBI's MDB</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>C_REF</name>
              <description>Controller counter from IBI start to the first SCL positive-going edge after the IBI ACK</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
