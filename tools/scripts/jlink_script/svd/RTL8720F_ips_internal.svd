            </field>
          </fields>
        </register>
        <register>
          <name>ELR_ADR1</name>
          <addressOffset>0x00001110</addressOffset>
          <size>32</size>
          <description>Error log addrress register1</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
