              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCH_CNT_RST</name>
              <description>write "1" to set the BIT_EDCA_REF_STS_CNT to zero</description>
              <bitRange>[28:28]</bitRange>
