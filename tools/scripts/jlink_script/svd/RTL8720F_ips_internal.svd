              <description>This register sets the time from cca fall to 6us.  unit: 1us. (default:6us)</description>
              <bitRange>[11:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TM_TSFT_PORT_SEL</name>
