          <name>REG_DATA_RATE_MASK1</name>
          <addressOffset>0x00000460</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA_RATE_MASK_TABLE_1</name>
              <description>Data Auto Rate Fallback Table Register 1, indexed by fb_mask_idx in TXDESC.
Each bit is mapped as the following:

Bit[0:3] = {1M, 2M, 5.5M, 11M }
Bit[4:11] = {6M, 9M, 12M, 18M, 24M, 36M, 48M, 54M}
Bit[12:21] = HT/VHT/HE MCS0~MCS9</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_DATA_RATE_MASK2</name>
          <addressOffset>0x00000464</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA_RATE_MASK_TABLE_2</name>
              <description>Data Auto Rate Fallback Table Register 2, indexed by fb_mask_idx in TXDESC.
Each bit is mapped as the following:

Bit[0:3] = {1M, 2M, 5.5M, 11M }
Bit[4:11] = {6M, 9M, 12M, 18M, 24M, 36M, 48M, 54M}
Bit[12:21] = HT/VHT/HE MCS0~MCS9</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_DATA_RATE_MASK3</name>
          <addressOffset>0x00000468</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA_RATE_MASK_TABLE_3</name>
              <description>Data Auto Rate Fallback Table Register 3, indexed by fb_mask_idx in TXDESC.
Each bit is mapped as the following:

Bit[0:3] = {1M, 2M, 5.5M, 11M }
Bit[4:11] = {6M, 9M, 12M, 18M, 24M, 36M, 48M, 54M}
Bit[12:21] = HT/VHT/HE MCS0~MCS9</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CTRL_RATE_MASK</name>
          <addressOffset>0x0000046C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CTRL_RATE_MASK_TABLE</name>
              <description>CTRL(RTS/CTS2S) Auto Rate Fallback Table Register.
Each bit is mapped as the following:

Bit[0:3] = {1M, 2M, 5.5M, 11M }
Bit[4:11] = {6M, 9M, 12M, 18M, 24M, 36M, 48M, 54M}
Bit[12:21] = HT/VHT/HE MCS0~MCS9</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_TXRPT_CTRL</name>
          <addressOffset>0x00000470</addressOffset>
