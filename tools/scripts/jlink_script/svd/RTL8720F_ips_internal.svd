        <register>
          <name>CAPS</name>
          <addressOffset>0x000001F0</addressOffset>
          <size>32</size>
          <description>Capabilities register</description>
          <resetValue>0x00183101</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GETCAP4</name>
              <description>Reserved</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>GETCAP3</name>
              <description>[20] = 1: Defining Byte Support in GETSTATUS
[19] = 1: Defining Byte Support in GETCAPS</description>
              <bitRange>[23:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>GETCAP2</name>
              <description>[13:12] = 3: Group Address Capabilities , can be assigned three Group address
[11:8] = 1: I3C 1.x Specification Version = V1.1 
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>GETCAP1</name>
              <description>[0] = 1: HDR Mode; 0: HDR-DDR
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GIT</name>
          <addressOffset>0x000001F8</addressOffset>
          <size>32</size>
          <description>GIT num register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TAG_NUM</name>
              <description>Indicate the commit number of the released RTL code 
ex: tag 2.0.1 GIT_NUM = 0x00_02_00_01</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IDR</name>
          <addressOffset>0x000001FC</addressOffset>
          <size>32</size>
          <description>Identification Register</description>
          <resetValue>0x03560000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IP_NUM</name>
              <description></description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RELEASE_DATE</name>
              <description>Indicate the IP release date for the particular project 
ex: the released date is 01/26, ELEASE_DAT =0x0126</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
