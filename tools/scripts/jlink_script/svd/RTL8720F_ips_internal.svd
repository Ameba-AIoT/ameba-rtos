        <register>
          <name>REG_CHINFO_ADDR</name>
          <addressOffset>0x000006EC</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
