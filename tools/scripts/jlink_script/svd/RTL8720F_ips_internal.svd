            <field>
              <name>TBTT_AREA_BLK_4AC</name>
              <description>When set this bit, 4AC backoff is disabled on TBTT setup period</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_TBTT_AREA_FOR_BB</name>
              <description>enable notify bb that mac p0 is in tbtt area</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TBTT_PROHIBIT_HOLD</name>
              <description>TBTT_prohibit_hold time for AP mode, unit is 32 us</description>
              <bitRange>[19:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TBTT_PROHIBIT_HOLD_INFRA</name>
              <description>TBTT_prohibit_hold time for infrastructure mode , unit is 2 ms</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TBTT_PROHIBIT_SETUP</name>
              <description>TBTT_prohibit_setup, unit is 32us;
If en nan-CG, this value should be set to 0x06.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_TXOP_PRE_BKF</name>
          <addressOffset>0x00000520</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x400F400F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NAV_END_TXOP</name>
              <description>1: In txop mode, Nav protect all txop 
0: In txop mode, Nav protect to next pkt</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NOPKT_END_RTSMF</name>
              <description>1: enable exit rts hold mode when there is no corresponding ac pkt to tx</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RTS_NAV_TXOP</name>
              <description>enable RTS NAV protect all txop</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NOT_CROSS_TXOP</name>
              <description>1:tx pkt cross tbtt is prohibited 0:tx pkt cross tbtt is permitted</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NAV_BLK_HGQ</name>
              <description>rxnav block HGQ</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NAV_BLK_MGQ</name>
              <description>rxnav block MGQ</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PRE_BKF_TIME</name>
              <description>when bkf timer count down this value, sel queue and gen txcmd will start. Unit: 1us</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NAV_NXT_TIME</name>
              <description>In TXOP mode ,NAV setting which protects next packets</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXOP_MIN</name>
              <description>if txop counter is more than this value, than tx pkt is considered not cross tbtt. Unit: 1us</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_TSFT_BCN_P0_P1_CTRL</name>
          <addressOffset>0x00000524</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x0010E002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SCHEDULER_RST</name>
              <description>Write this bit reset scheduler, ioreg_txfail</description>
              <bitRange>[31:31]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>BYPASS_ADJ_TBTT_AREA</name>
              <description>0: Fixed an issue where tbtt_area kept pulling higher caused by tbtt_int miss 
1: follow the original practice</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_FREECNT</name>
              <description>enable freerun tsft</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RESET_FREECNT_P</name>
              <description>reset pulse of freerun tsft</description>
              <bitRange>[24:24]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>EN_MULTI_BCN</name>
              <description>enable multiple beacons of port0~port2</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MULTI_BCN_CS</name>
              <description>indicate which port is tx beacon</description>
              <bitRange>[19:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EN_AUTO_MASK_RXPRSP_UPD</name>
              <description>valid when BIT_EN_RXPRSP_UPD = 1
1: auto disable RXPRSP's tsft update when rx probe response frame during bcn_early to tbtt(for STA mode - P0)</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_RXPRSP_UPD</name>
              <description>1: enable update tsft when RX probe response frame. (for STA mode - P0)</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P1_AUTO_SYNC_TSFT0_EN</name>
              <description>when P0 + P1 is concurrent mode, need to assert
1: sync P1's TSFT = P0's TSFT + TSFTF_SYN_OFFSET each time
0: P1's TSFT = P0's TSFT</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P1_DIS_BCN</name>
              <description>set 1 to mask the beacon early interrupt of port1</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P1_EN_BCNQ</name>
              <description>When this bit is set, TSF and other beacon related functions are then enabled.
0x700(MACID1)的enable开关</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_TSFT_EN</name>
              <description>1: enable P0 TSFT counter, when NAN function is disable, P1 used P0 TSFT counter</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_TSFT_RST</name>
              <description>write this bit, bcn0 tsft will auto reset, reset to 1</description>
              <bitRange>[4:4]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>P0_DIS_BCN</name>
              <description>set 1 to mask the beacon early interrupt of port0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_DIS_RX_BSSID_FIT</name>
              <description>0:HW will handle rx_beacon 1:HW will ignore rx_beacon_pk</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_DIS_TSF_UPT</name>
              <description>When set, disable port 0 TSF update when beacon frames or probe response frames are received.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_EN_BCNQ</name>
              <description>enable beacon function. When this bit is set, TSF and other beacon related functions are then enabled.
0x610(MACID)的enable开关</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
