    <peripheral>
      <name>PPE_REG</name>
      <baseAddress>0x41900000</baseAddress>
      <size>0x000001D0</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x000001D0</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>GLB_STATUS</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>Global status Register</description>
          <resetValue>0x00000007</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CHN_INACT</name>
              <description>Indicates whether the internal DMA channels are inactive (protocol over).
Bit 15:
0x0: There are currently outstanding transactions for AWID=0
0x1: There are currently no outstanding transactions for AWID=0
Bit i (16 &lt;= i &lt;= 31):
0x0: There are currently outstanding transactions for ARID=i-16
0x1: There are currently no outstanding transactions for ARID=i-16</description>
              <bitRange>[31:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RUN_STATUS</name>
              <description>Run status
0x0: Disabled
0x1: Runing
0x2: Inactive (w/o outstanding)
0x3: Suspend (w/ outstanding)
Others: reserved</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LAY_EN</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description>Layer enable register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INPUT_LAY_EN</name>
              <description>Input layers enable field.
Bit i (1 &lt;= i &lt;=3 )
0x0: Input layer i is disabled.
0x1: Input layer i is enabled.</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RELOAD_CFG</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>Reload configuration Register</description>
          <resetValue>0x00020000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>AUTO_CLR</name>
              <description>Auto clear "SET_VALID" after loading layer settings</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SET_VALID</name>
              <description>Setting is valid
Will be auto set to 1 when writing 1 to GLB_EN</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LYR_RELOAD_EN</name>
              <description>Layers setting reload enable
Bit0~15: Layer0~15</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LL_CFG</name>
          <addressOffset>0x0000000C</addressOffset>
