              <name>PATH_DELAY_NS_CCK</name>
              <description>the NS part of RX CCK1M PATH DELAY</description>
              <bitRange>[31:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PATH_DELAY_NS_OFDM</name>
