        <register>
          <name>REG_DUMMY_CTRL</name>
          <addressOffset>0x00000028</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>REG_DMY_L</name>
              <description>bit[8:7] -- 00: POR_AON; 01: RSTB_BOD_RESET; 10: RSTB_LV; 11:POR_OFF
bit[6]    -- 1: select CLK_OSC2M, CLK_OSC32K, CLK_OSC128K
  (watch REG_MUX_SEL_128K, REG_MUX_SEL_OSC)
  0: select POR_AON, RSTB_BOD_RESET, RSTB_LV,POR_OFF</description>
