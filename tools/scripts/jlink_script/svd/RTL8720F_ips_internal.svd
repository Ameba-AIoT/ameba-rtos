        <register>
          <name>ENDXFER</name>
          <addressOffset>0x000000BC</addressOffset>
          <size>32</size>
          <description>ENDXFER Early Termination Parameters Register</description>
          <resetValue>0x00FF0040</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>METM_CAP</name>
              <description>Indicate Monitoring Device Early Termination Capability
8'hff: Disable all
8'h01: Enable on SDR
8'hfe: Disable on SDR
8'h02: Enable on HDR-DDR
8'hfd: Disable on HDR-DDR
Other settings are not supported
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ETM_CRC</name>
              <description>2'b11: No CRC Word follows Early Termination request 
2'b01: CRC Word follows Early Termination
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WR_ETM</name>
              <description>Enable HDR WRITE Early Termination Request 
1'b0: Enable 
1'b1: Disable
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WR_NACK</name>
              <description>Enable ACK/NACK Capability for WRITE Command
1'b0: Enable 
1'b1: Disable
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
