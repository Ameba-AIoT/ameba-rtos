        <register>
          <name>chn0_aes_int_raw</name>
          <addressOffset>0x00000EF0</addressOffset>
          <size>32</size>
          <description>Raw interrupt register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>error_cpu_fifo_raw</name>
              <description>Set to 1 when the user uses slave mode and writes data when input data fifo is full or reads data when output data fifo is empty.
(error condition is related to ctrl.block_pready)
*available after version 2024/08/19</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_ende_circuit_raw</name>
              <description>Set to 1 when the user uses the corresponding operation when closing the encryption or decryption circuit.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_decode_cipher_raw</name>
              <description>Set to 1 when the user sets a non-existent cipher mode.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_block_size_raw</name>
              <description>Set to 1 when the input size is not a multiple of 128 when using ECB or CBC mode.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>aes_slave_done_raw</name>
              <description>Set to 1 when aes has output data waiting for user to read  (*after version 2024/08/19)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn0_aes_int_mask</name>
          <addressOffset>0x00000EF4</addressOffset>
          <size>32</size>
          <description>Enable interrupt register</description>
          <resetValue>0x0000001F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>error_cpu_fifo_mask</name>
              <description>Interrupt error_cpu_fifo enable.
*available after version 2024/08/19</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_ende_circuit_mask</name>
              <description>Interrupt error_ende_circuit enable.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>error_decode_cipher_mask</name>
