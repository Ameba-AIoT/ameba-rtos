        <register>
          <name>REG_CHINFO_CFG</name>
          <addressOffset>0x000006F0</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x21180000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CHINFO_CONTENT_EN</name>
              <description>used for rx normal mode
1: the payload( excluding mac header/iv/eiv/mic/fcs) of the specified location must match the configured value
0: do not check the payload value</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_DROP_INVALID</name>
              <description>when set to 1, will drop channe info if valid bit of bb header is 0</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_FCS</name>
              <description>when set to 1, will not check channel info fcs ok flag</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_WTM_OUT</name>
              <description>BB does't send channel info when timeout occur</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CHINFO_TIME_OUT</name>
              <description>BB send channel info length is less than report length</description>
              <bitRange>[26:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CSI_BUFF_FULL</name>
              <description>Indicate rxcsibuff full occur</description>
              <bitRange>[25:25]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CHINFO_DATA_WTLMT</name>
              <description>Wait timeout value after repuest channe info, unit 4 mac clock cycles</description>
              <bitRange>[24:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_RPT_DUMMY</name>
              <description>1:rx chinfo rpt alll segment
0: rx chinfo rpt only data</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_TXADDR_EN</name>
              <description>1: chinfo trigger condition need check a2 match txaddr or rx is cts/ack
0: not need to check a2</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_A1_EN</name>
              <description>1: chinfo trigger condition need check a1 match self mac address
0: not need to check a1</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_MODE</name>
              <description>channel info mode setting. 0: enable normal rx trigger; 1: enable ndpa trigger; note: repsonse mode decided by tx descriptor. Valid when r_CHINFO_EN is 1.</description>
              <bitRange>[18:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_EN</name>
              <description>enable for getting channel info from BB. When set to 0, will not trigger channel info function</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHINFO_TX_ADDR_H</name>
              <description>high 16bit tx address for trigger channel info</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
