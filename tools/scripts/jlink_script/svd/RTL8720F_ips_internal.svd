          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EthrntRxCPU_Des_Num_1_7_0</name>
              <description>Indicate the number of descriptor of 1st queue, which has been finished Rx process and returned to IO by CPU. After ending Rx process, CPU needs to update this field.</description>
