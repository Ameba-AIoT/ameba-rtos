        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD2_3</name>
          <addressOffset>0x000000EB</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword2_3</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD3_0</name>
          <addressOffset>0x000000EC</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword3_0</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD3_1</name>
          <addressOffset>0x000000ED</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword3_1</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD3_2</name>
          <addressOffset>0x000000EE</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword3_2</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD3_3</name>
          <addressOffset>0x000000EF</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword3_3</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
