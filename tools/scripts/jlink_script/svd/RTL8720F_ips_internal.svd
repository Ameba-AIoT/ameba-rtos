          <description>Error log ID information register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_ID</name>
              <description>Tagid of the error request.
8'b00000???: M0 access error
8'b000100??: M1 access error
8'b0100????: M2 access error
8'b000101??: M3 access error
8'b0101000?: M4 access error
8'b0001100?: M5 access error
8'b01100???: M6 access error    
8'b001?????: M7 access error
8'b1101????: M8 access error
8'b11100???: M9 access error
8'b1111000?: M10 access error
8'b101?????: M11 access error</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
