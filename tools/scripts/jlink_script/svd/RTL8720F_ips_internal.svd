              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>aes_slave_done_mask</name>
              <description>Interrupt aes_slave_done enable.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn0_aes_int_status</name>
          <addressOffset>0x00000EF8</addressOffset>
          <size>32</size>
          <description>Masked interrupt register</description>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>error_cpu_fifo_status</name>
