              <name>INTR_RAW_SECURE_ERR</name>
              <description>Secure error
Raised after non-secure APB request access secure PPE.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_RAW_SUSP_INAC</name>
              <description>Master port inactive after being suspended
Raised after the master port is inactive and PPE is suspended.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_RAW_LINE_OVER</name>
              <description>Line index over
Raised after the transaction of last pixel of LINE_INDEX marked line has been completed.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_RAW_LOAD_OVER</name>
              <description>Register load over
Raised after layers registers load to internal DMA.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_RAW_FR_OVER</name>
              <description>Frame over
Raised after every frame completion.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_RAW_ALL_OVER</name>
              <description>All frames over
Raised after all frames completion.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_CLR</name>
          <addressOffset>0x00000048</addressOffset>
