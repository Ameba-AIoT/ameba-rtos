        <register>
          <name>CTC_ONLY1</name>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEL_TOUCH_CUR</name>
              <description>Touch compensate current:
When Cm 1800mV example:
50uA+&lt;4:0&gt;*5uA:

Current = (50uA +&lt;4:0&gt;*5uA)*(Vcm/180K)/10uA;

AIF default 01000,current 80uA;</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTC_ONLY2</name>
          <addressOffset>0x00000018</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000004</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEL_TOUCHCMP_VREF</name>
              <description>Touch Comparator Vref:
000:0.5V
001:0.525V
010:0.55V
011:0.575v
100:0.60V
101:0.625V
110:0.65V
111:0.675V
AIF default 100:0.6V;</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
