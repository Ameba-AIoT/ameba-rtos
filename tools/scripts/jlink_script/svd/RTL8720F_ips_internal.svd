            </field>
            <field>
              <name>pmc_state_jump_en7</name>
              <description>1: when current afe pmc state hit pmc_src_state7, next pmc state will jump to pmc_dst_state7;  0:afe pmc follow old flow</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pmc_dst_state6</name>
              <description>destination pmc state6 for state jump</description>
              <bitRange>[14:8]</bitRange>
