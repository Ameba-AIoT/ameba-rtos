0: SHA2 is enabled</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RSVD</name>
              <description>Reserved</description>
              <bitRange>[11:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SM3_CORE_EN</name>
              <description>1: SM3 is implmented
0: SM3 is not implmented</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SHA1_CORE_EN</name>
              <description>1: SHA1 is implmented
0: SHA1 is not implmented</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TRUST_ZONE_EN</name>
              <description>0: disabled
1: enabled</description>
              <bitRange>[7:7]</bitRange>
