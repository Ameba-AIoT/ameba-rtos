1: nor flash
2: nand flash</description>
              <bitRange>[23:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BOOT_CNT_LMT_EN</name>
              <description>Enable boot count limit
0: disable
1: enable</description>
              <bitRange>[21:21]</bitRange>
