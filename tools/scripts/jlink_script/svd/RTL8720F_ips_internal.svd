              <description>Priority (ARQos) (Reserved)</description>
              <bitRange>[31:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LL_MAX_ARLEN_LOG</name>
              <description>Limit of ARLen (Reserved)</description>
              <bitRange>[26:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LL_ARCACHE</name>
              <description>ARCache (Reserved). Refer to AXI4 protocol.</description>
              <bitRange>[23:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
