              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SEC_NONCE_3</name>
          <addressOffset>0x0000022C</addressOffset>
          <size>32</size>
          <description>SEC region 3 nonce register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEC_NONCE3</name>
              <description>Only present if SEC_CONF_MODE &gt; 0.
Seed of scrambler mode 3.
This register value cannot be 0, otherwise the encrypted data will be equal to the original data.
Note: Available only if configuration of PSRAM_EN is defined.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
