        </register>
        <register>
          <name>LCDC_MCU_CMD_WRNUM</name>
          <addressOffset>0x000000F0</addressOffset>
          <size>32</size>
          <description>number of mcu predefined cmd</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_wrnum</name>
              <description>number of mcu predefined cmd, unit: byte</description>
