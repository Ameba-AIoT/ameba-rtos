        <register>
          <name>INPUT_LAYER1_PIC_CFG</name>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <description>Picture configuration register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INPUT_LAYER1_LINE_LEN</name>
              <description>Indicates the bytes in memory between two vertically adjacent pixels.</description>
              <bitRange>[26:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INPUT_LAYER1_KEY_MODE</name>
              <description>Color keying match mode
0x0, 0x1: Disable
0x2: Inside ((Rmin&lt;=R&lt;=Rmax) &amp; (Gmin&lt;=G&lt;=Gmax) &amp; (Bmin&lt;=B&lt;=Bmax))
0x3: Outside ((R&lt;Rmin) | (R&gt;Rmax) | (G&lt;Gmin) | (G&gt;Gmax) | (B&lt;Bmin) | (B&gt;Bmax))</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
