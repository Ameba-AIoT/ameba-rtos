    <peripheral>
      <name>DEBUGTIMER_REG</name>
      <baseAddress>0x40804000</baseAddress>
      <size>0x0000001C</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x0000001C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DBGT_CTRL</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>debugtimer control register</description>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_crv_set</name>
              <description>set dbgt_crv0/1 to  dbgtcnt</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>enable</name>
              <description>Debug timer enable.
1: The counter is enabled.
0: The counter is disabled.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGT_CRV0</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description>debugtimer count register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_crv0</name>
              <description>dbgtcnt[31:0].Continuing to count from 0 once it's reached 32'Hffffffff</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGT_CRV1</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>debugtimer count register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_crv1</name>
              <description>dbgtcnt[63:32].Continuing to count from 0 once it's reached 32'hFFFFFFFF</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGT_ATOM_INC</name>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <description>debugtimer atom read increase</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_atom_inc</name>
              <description>Each read will increase 1 and return to the increased value to bus.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGT_ATOM</name>
          <addressOffset>0x00000010</addressOffset>
          <size>32</size>
          <description>debugtimer atom</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_atom</name>
              <description>Return the last increased value of atom counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGT_SCRATCH</name>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <description>debugtimer scratch</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dbgt_scratch</name>
              <description>Reserved for user use</description>
              <bitRange>[31:0]</bitRange>
