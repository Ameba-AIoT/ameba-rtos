              <access>read-only</access>
            </field>
            <field>
              <name>R_START_DET</name>
              <description></description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>R_STOP_DET</name>
              <description></description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>R_ACTIVITY</name>
              <description></description>
