          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRADE</name>
              <description>Timeout grade                                                                                                                                                                                                                                      Timeout total cycle = [256*(2^(grade-1) +1)*threshold] - inaccurate                                                                                                       Note1: the range of inaccurate = 0 ~ [256*(2^(grade-1) +1)-2]                                                                                              Note2: If threshold is 0x0, the Timeout_total_cycle is always 1</description>
