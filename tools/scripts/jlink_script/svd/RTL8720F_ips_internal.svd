              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_PLFM1_MST</name>
              <description>The register can only written to 0 when a SIC/OTPC/ARS_SHA/GDMA time out occures, and automatically clear this register by hardware</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_KM4NS</name>
              <description>The register can only written to 0 when a KM4NS time out occures, and automatically clear this register by hardware</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_SRAMC</name>
              <description>The register can only written to 0 when a SRAMC time out occures, and automatically clear this register by hardware</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG0</name>
          <addressOffset>0x00001380</addressOffset>
          <size>32</size>
          <description>Timeout monitor configuration register0</description>
          <resetValue>0x000F00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRADE</name>
              <description>Timeout grade                                                                                                                                                                                                                                      Timeout total cycle = [256*(2^(grade-1) +1)*threshold] - inaccurate                                                                                                       Note1: the range of inaccurate = 0 ~ [256*(2^(grade-1) +1)-2]                                                                                              Note2: If threshold is 0x0, the Timeout_total_cycle is always 1</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>THRESHOLD</name>
              <description>Timeout threshold</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG1</name>
          <addressOffset>0x00001384</addressOffset>
          <size>32</size>
          <description>Timeout monitor configuration register0</description>
