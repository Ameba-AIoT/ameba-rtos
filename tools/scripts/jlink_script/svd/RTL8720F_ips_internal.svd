          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword2_1</name>
              <description>mcu predefined cmd before data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCDC_MCU_CMD_DWORD2_2</name>
          <addressOffset>0x000000EA</addressOffset>
          <size>8</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>mcu_cmd_dword2_2</name>
              <description>mcu predefined cmd before data</description>
