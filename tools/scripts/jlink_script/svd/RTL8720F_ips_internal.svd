            <field>
              <name>adc_sel_vrefp_vol_0</name>
              <description>AUX ADC Vrefp voltage:
0000:1.45V
0001:1.50V
0010:1.55V
0011:1.60V
0100:1.65V
0101:1.70V
0110:1.75V
0111:1.80V
1000:1.85V
1001:1.875V
1010:1.90V
1011:1.95V
1100:2.00V
1101:2.05V
1110:2.10V
1111:2.15V

Cs * VIN = 8C * Vrefp
3C * 5V = 8C * 1.875V
4C * 3.3V = 8C * 1.65V
8C * 1.8V = 8C * 1.8V
AIF default 0100: 1.65V;</description>
