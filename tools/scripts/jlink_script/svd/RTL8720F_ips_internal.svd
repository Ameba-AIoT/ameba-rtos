          <resetValue>0x000030D4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TSTA_TO</name>
              <description>Timeout count for pulling SCL=Low when SDA is Low at SEC HP flow.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TDR</name>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <description>Reserved</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TSTALL_TO</name>
              <description>Timeout count for SCL stall. Timeout = TSTALL_TO*32.
Set 0 disable SCL stall timeout.
ex. set 1 =&gt; timeout occur when counter count 32T</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>THPR</name>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <description>Reserved</description>
          <resetValue>0x007D001E</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TNCRL</name>
              <description>tNEWCRLock timing count</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TCRHPOVLP</name>
              <description>tCRHPOverlap timing count</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>THPTMR</name>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <description>Reserved</description>
          <resetValue>0x000030D4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TSDA_TO</name>
              <description>Timeout count for pulling SDA=Low when SEC HP.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TDLYR</name>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <description>Timing delay register</description>
          <resetValue>0x00040100</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RDGE</name>
              <description>RX SDR data capture edge
0: high edge
1: low edge
Only valid when cr_9dge set
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>9DGE</name>
              <description>RX SDR data capture edge
0: data+9th(ack, T bit) capture at high edge
cr_rhdy = 0; rx data: SDA before high edge according odly/pdly
cr_rhdy = 1; rx data: SDA after high edge according odly/pdly
1: according CR_RDGE determine capture edge</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ODLY</name>
              <description>SDA Received delay count for header/data phase with OD mode</description>
              <bitRange>[29:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PDLY</name>
              <description>SDA Received delay count for header/data phase with PP mode</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CDLY</name>
              <description>SCL Received delay count</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TDLYR2</name>
          <addressOffset>0x00000054</addressOffset>
          <size>32</size>
          <description>Timing delay register2</description>
          <resetValue>0x000B0105</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RHDY</name>
              <description>RX SDR data capture high edge with delay count
1: with delay count (ODLY/PDLY)
0: without delay count
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADLY</name>
              <description>SDA Received delay count for 9th of header/data phase with OD mode
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[29:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DDR_RDGE</name>
              <description>Indicate capture point in DDR mode
Rely on CR_DDR_PDLY to determine capture data/point
0: capture data at edge, data is according to DDR_PDLY
DDR_PDLY= 0 =&gt; sda reg in delay 0T (sda_in_r)
DDR_PDLY= 1 =&gt; sda reg in delay 1T (sda_in_r1)
DDR_PDLY= 2 =&gt; sda reg in delay 2T (sda_in_r2)
DDR_PDLY= 3 =&gt; sda reg in delay 3T (sda_in_r3)
1: capture data after edge with delay (delay is according to DDR_PDLY)
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DDR_PDLY</name>
              <description>SDA Received delay count for DDR mode</description>
              <bitRange>[14:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PRE_DLY</name>
              <description>The timing for SCL keep in low before preamble phase in DDR mode (min: BDR_PP)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRST</name>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <description>Timing bus reset register</description>
          <resetValue>0x00060000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BRST</name>
              <description>BUS reset timing count. Timeout = TSTALL_TO*64.</description>
              <bitRange>[19:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>METM</name>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <description>Monitor early terminate register</description>
          <resetValue>0x0000FFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DISEC_ADDR</name>
              <description>The dynamic address of the TAGT which won BUS arbitration and not known to be a Monitoring Device</description>
              <bitRange>[25:19]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_DISEC</name>
              <description>Indicate the BUS arbitration was won by a TAGT not known to be a Monitoring Device
User should disable this TAGT driven IBI</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_ETM</name>
              <description>Indicate the previous transaction has been early terminated</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CETM_EN</name>
              <description>Enable CTRL early terminate feature to terminate long transactions</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CETM_MAX_LEN</name>
              <description>The maximum length of transaction that should be early terminated by CTRL
The maximum length = 256 * (CETM_MIN_LEN + CETM_MAX_LEN), unit: CTRL clk cycle</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CETM_MIN_LEN</name>
              <description>The minimum length of transaction that should not be early terminated by CTRL
The minimum length = 256 * CETM_MIN_LEN, unit: CTRL clk cycle</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TXFL</name>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <description>TXDA FIFO Level Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXFTL</name>
              <description>Waterlevel for DMAC TX handshake
If TXFTL = 0/1, I3CC only support single transcation; else, I3CC support burst + signle transcation (for DMAC flow, not I3C transcation).
Available value: 0x0, 0x1, 0x4, 0x8, 0x16, ... (&lt;= TDFR_DEPTH)
Exist: Tag &gt;= 2.2.1</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXFL</name>
              <description>TXDA FIFO level</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RXFL</name>
          <addressOffset>0x00000074</addressOffset>
          <size>32</size>
          <description>RXDA FIFO Level Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RXFTL</name>
              <description>Waterlevel for DMAC RX handshake
If RXFTL = 0/1, I3CC only support single transcation; else, I3CC support burst + signle transcation (for DMAC flow, not I3C transcation).
Available value: 0x0, 0x1, 0x4, 0x8, 0x16, ... (&lt;= RDFR_DEPTH)
Exist: Tag &gt;= 2.2.1</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXFL</name>
              <description>RXDA FIFO level</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGI</name>
          <addressOffset>0x00000078</addressOffset>
          <size>32</size>
          <description>DBG Index Register</description>
          <resetValue>0x88000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DBG_P_PH</name>
              <description>Debug infomation P_PH</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DBG_D_PH</name>
              <description>Debug infomation D_PH</description>
              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DBG_H_PH</name>
              <description>Debug infomation H_PH</description>
              <bitRange>[29:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DBG_S_PH</name>
              <description>Debug infomation S_PH</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_P_PH</name>
              <description>Debug information RX P_PH.
If detect START, RX_P_PH = 0
If detect STOP, RX_P_PH =1</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>IXC_TX</name>
              <description>1 = IXC Send out SDA Data
0 = IXC Receive SDA Data</description>
              <bitRange>[26:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DPIDX</name>
              <description>Debug Port Signal index
Bit[3]:
1: TIC_DP
0: IXC_DP
Bit[2:0]:Select 16 signals from total 64 signals.</description>
              <bitRange>[23:20]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>TEST</name>
              <description>Test mode enable (1 = enable, 0 = disable)
Use a Vendor/Standard Extension - Direct CCCs to read/write access to rxi356_i3cc control registers</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TEST_MEM</name>
              <description>Data register enable (1 = enable (only when TEST = 1), 0 = disable)
When enable, read/write will access to CR_MEM_DR, not FIFO.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MIDX</name>
              <description>Index of MDB list groups
0x0: MDB index to 31~0
0x1: MDB index to 63~32
0x2: MDB index to 95~64
0x3: MDB index to 127~96</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GIDX</name>
              <description>Debug index of debug FIFO</description>
              <bitRange>[9:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GSEL</name>
              <description>Debug access to BYFM/TXDA/BYFM/MDB
0x0: write access to MDB
0X1: read/write access to TXDA FIFO
0x2: read/write access to RXDA FIFO
0x3: read/write access to BYFM FIFO</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DBGR</name>
          <addressOffset>0x0000007C</addressOffset>
          <size>32</size>
          <description>DBG Data Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GDR</name>
              <description></description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EC</name>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <description>I3C Target Events Byte Register</description>
          <resetValue>0x10000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IPLS</name>
              <description>For TAGT: indicate IBI payload size for SETMRL/GETMRL. the thrid byte data if BCR[2] == 1
For CTRL: indicate IBI Payload Max size. If the IBI length &gt; IPLS, CTRL would abort this IBI transaction.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MPID</name>
              <description>Indicate I3C.
PID[31:0] value is used from CR_PIDH and CR_PIDL
If MPID == 1, I3C.PID[31:0] = \{CR_PIDH[15:0], CR_PIDL[31:16]}
If MPID == 0, I3C.PID[31:0] = I3CC input port: user_pid_31_0
*. PID[47:0] = \{CRR_PIDH[31:0], CR_PIDL[31:16]} needs to following I3C.PID format
If PID[32] == 1, PID[31:0] is vairable value</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HJ</name>
              <description>For TAGT: indicate Taget device. taget event[3] value
1: ENHJ by CCC: ENEC.taget event byte[3]
0: DISHJ by CCC: DISEC.taget event byte[3]
For CTRL:
If 1, then ACK Hot Join, and put interrupt rxhji.
If 0, then NACK Hot Join.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CR</name>
              <description>For TAGT: indicate Taget device. taget event[1] value
1: ENCR by CCC: ENEC.taget event byte[1]
0: DISCR by CCC: DISEC.taget event byte[1]
For CTRL:
If 1, then ACK Ctrl Role Req, and put interrupt rxsec.
If 0, then NACK Ctrl Role Req.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INT</name>
              <description>For TAGT: indicate Taget device. taget event[0] value
1: ENINT by CCC: ENEC.taget event byte[0]
0: DISINT by CCC: DISEC.taget event byte[0]
For CTRL:
If 1, then ACK IBI Req, and put interrupt rxibi and received the IBI payload if the TAGT send.
If 0, then NACK IBI Req.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AS</name>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <description>Activity State Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>AS</name>
              <description>Indicate Taget device. activity status
Set value by CCC: ENTAS0~ENTAS3
ex: AS=0x1 written by ENTAS1
AS0: activity state 0; 1 us
AS1: activity state 1; 100 us
AS2: activity state 2; 2 ms
AS3: activity state 3; 50 ms</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MXL</name>
          <addressOffset>0x00000088</addressOffset>
          <size>32</size>
          <description>Max Write/Read Length Register</description>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MRL</name>
              <description>Indicated the max read length for SETMRL/GETMRL
CR_MXL.MRL &gt;= CR_MXL_MIN.MRL_MIN</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MWL</name>
              <description>Indicated the max read length for SETXWL/GETMWL
CR_MXL.MWL &gt;= CR_MXL_MIN.MWL_MIN</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDL</name>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <description>PIDL register</description>
          <resetValue>0x13CC0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PID_l</name>
              <description>Indicated for I3C.PID[15:0]</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BCR</name>
              <description>Indicated for I3C.BCR</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DCR</name>
              <description>Indicated for I3C.DCR</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PIDH</name>
          <addressOffset>0x00000090</addressOffset>
          <size>32</size>
          <description>PIDH register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PID_H</name>
              <description>Indicated for I3C.PID[47:16] 
*. Following I3C.PID format 
If PID[32] == 1, PID[31:0] is vairable value; default PID[31:0] = I3CC input port: user_pid_31_0</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DSA</name>
          <addressOffset>0x00000094</addressOffset>
          <size>32</size>
          <description>Dynamic/Static Address Register</description>
          <resetValue>0x00004700</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DAA_DONE</name>
              <description>Indicated for I3C.dynamic address assignment (DAA) flow is done. 
If CR_DSA.DAA=1, it is indicated 
1. Dynamic address is used for Taget address by SETDASA or ENTDAA. 
2. Static address used for Taget address by SETAASA.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DAA_ING</name>
              <description>Indicated for I3C.dynamic address assignment flow is going. 
It is set after ENTDAA command is executed.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>STC_ADDR</name>
              <description>Indicated Static address[6:0] for target addreess[6:0]
Static address[17:8] for 10-bit Target addreess mode</description>
              <bitRange>[17:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DA1R_DIS</name>
              <description>For DA = 0x1 (SETDASA format 2), Read/GETCCC ACK disable
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DYN_ADDR</name>
              <description>Indicated Dynamic address[6:0] for Target addreess[6:0]</description>
              <bitRange>[6:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CCCST</name>
          <addressOffset>0x00000098</addressOffset>
          <size>32</size>
          <description>Device Status (GETSTATUS) Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>STATUS</name>
              <description>Indicate Target device current status
Reply the value by CCC: GETSTATUS</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MXDS</name>
          <addressOffset>0x0000009C</addressOffset>
          <size>32</size>
          <description>Max Data Speed Register</description>
          <resetValue>0x00000840</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXW</name>
