            </field>
            <field>
              <name>MAR5</name>
              <description>Multicast Register 5</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAR6</name>
              <description></description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAR7</name>
              <description>Multicast Register 7</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TxOKCNT</name>
          <addressOffset>0x00000010</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TxOK</name>
              <description>16-bit counter of  Tx Ok packets.  Rolls over automatically.  Write to clear.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RxOKCNT</name>
          <addressOffset>0x00000012</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RxOk</name>
              <description>16-bit counter of Rx Ok packets.  Rolls over automatically.  Write to clear.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TxErr</name>
          <addressOffset>0x00000014</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TxErr</name>
              <description>16-bit counter of TxErr packets.  Rolls over automatically.  Write  to clear. The source of TxErr are txunder, txabt(in half-duplex mode) or txlinkerr.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RxErr</name>
          <addressOffset>0x00000016</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RxErr</name>
              <description>16-bit counter of RxErr packets. Rolls over automatically. Write to clear.  The source of RxErr are GMAC meets the following condition when rx fifo is not full.: 
1.  RCR.accept runt = 0, but the ingress pkt length &lt; 64B. 
2.  RCR.accepterr = 0, but the ingress pkt is a CRC error pkt.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MissPkt</name>
          <addressOffset>0x00000018</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MissPkt</name>
              <description>16-bit counter of Missed packets. 
Rolls over automatically. 
Write to clear.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FAE</name>
          <addressOffset>0x0000001A</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FAE</name>
              <description>16-bit counter of FAE (Frame Alignment Error) packets.  Rolls over automatically.  Write to clear. RCR.AER should be high. 
When FAE occurs in 10/100mode, the following thins happens: 
*Rx status des.CRC error does not assert if the ingress(exclude alignment error nibble) if correct. 
*RxErr_reg increased by 1. 
*FAE_reg increased by 1 
*Rx status des.RCDF does not asserts. 
data length does not include alignment error nibble.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>Tx1Col</name>
          <addressOffset>0x0000001C</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Tx1Col</name>
              <description>16-bit counter of  TxCol packets.  Rolls over automatically.  Write to clear.  This only record which have entered just one collision before Tx OK</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TxMCol</name>
          <addressOffset>0x0000001E</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TxMCol</name>
              <description>16-bit counter of TxCol packets.  Rolls over automatically.  Write to clear.  This keeps track of those packets with less than 16 collisions (or the configured retry count) before Tx Ok</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RxOkPhy</name>
          <addressOffset>0x00000020</addressOffset>
