        <register>
          <name>REG_PMC_OPT</name>
          <addressOffset>0x00000064</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x0F000070</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>thm_resume_cnt</name>
              <description>After thermal reset happen , it will wait a timer then reboot itself . 
This count unit in 0.65ms</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>aon_ret_en</name>
              <description>Option if aon enter retention mode when DSLP, to save more power
1: when enter to DSLP , aon pmc will shutdown more power
0: as before</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>adc_xtal_mode</name>
              <description>Select xtal mode when xtal used for adc/ctc/comp.
1: Normal
0: LPS</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>snooze_pdck</name>
              <description>Select xtal auto pdck function for sdm calibration use xtal lps mode
1:Enable
0:Disable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>sdm_xtal_mode</name>
              <description>Select xtal mode when xtal used for sdm calibration.
1: Normal
0: LPS</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PST_WAIT_XTAL</name>
              <description>1: When POF , polling xtal invalid signal and then run forward
0: not polling xtal invalid</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PST_DSLP_ESCK</name>
              <description>1: Enable all sdm132k/rtc32k clock  when PMC enter deep-sleep mode 
0: Gating part of sdm132k/rtc32k to save power when enter deep sleep</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PST_DSLP_ERCK</name>
              <description>1: Enable 100K clock for AON register access when PMC enter deep-sleep mode 
0: Disable
Note: Default not used , pmc patch may use it</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PST_DSLP_LDHM</name>
              <description>1: Enable AON LDO enter into sleep mode when  PMC enter deep-sleep mode
0: Disable
Note: Default not used , pmc patch may use it</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
