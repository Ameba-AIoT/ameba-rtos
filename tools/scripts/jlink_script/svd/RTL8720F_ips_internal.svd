          <name>STATUSBLOCK_L</name>
          <addressOffset>0x000002F0</addressOffset>
          <size>32</size>
          <description>Status for IntBlock Interrupt</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>STATUSBLOCK_L_Status_Block</name>
              <description>Interrupt status for chn0-chn15</description>
