          <resetValue>0x001E0060</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RXBCN_TIMEUP_COUNT1</name>
              <description>rxbcn timeup counter1</description>
              <bitRange>[30:24]</bitRange>
