          <name>TXUNDERC</name>
          <addressOffset>0x00000028</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXUNDERC</name>
              <description>16-bit counter of Tx Underrun packets. Rolls over automatically. 
Write to clear. 
gmac only.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
