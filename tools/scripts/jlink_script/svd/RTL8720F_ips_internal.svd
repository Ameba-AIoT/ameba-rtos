        <register>
          <name>REG_QUE_EMPTY_STOP</name>
          <addressOffset>0x00000428</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x003FFF00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RDQ_EMPTY</name>
              <description>When this bit is raised, RDQ queue is empty. Report by MAC.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EVTQ_EMPTY</name>
              <description>When this bit is raised, EVTQ queue is empty. Report by MAC.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BCNQ1_EMPTY</name>
              <description>When this bit is raised, beacon queue of PORT2 sync beacon / PORT2 disc beacon empty.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BCNQ0_EMPTY</name>
              <description>When this bit is raised, beacon queue of PORT1 SoftAP beacon  is empty.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HGQ_EMPTY</name>
              <description>When this bit is raised, HGQ queue is empty. Report by MAC.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MGQ_EMPTY</name>
              <description>When this bit is raised, MGQ queue is empty. Report by MAC.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AC7Q_EMPTY</name>
              <description>When this bit is raised, AC7 queue is empty. Report by MAC.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>AC6Q_EMPTY</name>
              <description>When this bit is raised, AC6 queue is empty. Report by MAC.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
