          <resetValue>0x00F0C000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>aip_info_rsvd1</name>
              <description>reserved for aip info indication</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>aip_ctrl_rsvd1</name>
              <description>reserved for aip info indication</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dummy</name>
              <description>Reserved for HW ECO</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dvp_dummy_data_en</name>
              <description>dvp dummy data enable
1: enable extra dummy data fliter, only work in the end of frame
0: disable extra dummy data fliter, only flitir out 0xffff</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dvp_dummy_data</name>
              <description>dvp dummy data</description>
              <bitRange>[12:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>otpc_dslp_trig</name>
              <description>It can trig OTP to accelerate power-off.</description>
              <bitRange>[4:4]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>auxadc_vccoffb</name>
              <description>1: enable auxadc power cut
0: shutdown auxadc all power cut for power saving
when scan mode , it will tie0,  also ISO signal must tie 1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dummy</name>
              <description>Reserved for HW ECO</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>xtal_bus_isolation</name>
              <description>plfm1 write to xtal bus isoable enable.
1: disable bus access
0: enable bus access
Note: this bit only assert when plfm1 pre-reset happen to protect bus mistake</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>plfm1_reset_confirm</name>
