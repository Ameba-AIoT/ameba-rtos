          <resetValue>0x0F8005C0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HIGH_BIT_NUM_HS_INT3</name>
              <description>Number of hardware handshake interfaces. If it is 128, this bit read value is 1.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HIGH_BIT_NUM_HS_INT2</name>
              <description>Number of hardware handshake interfaces. If it is greater than 63 and less than 128, this bit read value is 1.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>HIGH_BIT_NUM_HS_INT1</name>
              <description>Number of hardware handshake interfaces. If it is greater than 31 and less than 64, this bit read value is 1.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>STATIC_ENDIAN_SELECT</name>
              <description>The value of this register is derived from the DMAC_STATIC_ENDIAN_SELECT parameter.
0 = FALSE (dynamic endian fixed)
1 = TRUE (not supported)</description>
              <bitRange>[28:28]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ADD_ENCODED_PARAMS</name>
              <description>The value of this register is derived from the DMAC_ADD_ENCODED_PARAMS parameter.
0 = FALSE
1 = TRUE</description>
              <bitRange>[27:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NUM_HS_INT</name>
              <description>Number of hardware handshake interfaces. The value of this register is derived from the DMAC_NUM_HS_INT parameter.
NUM_HAS_INT = DMAC_NUM_HS_INT[4:0]
0x00 = 0
... 
0x10 = 16</description>
              <bitRange>[26:22]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>M2_DATA_WIDTH</name>
              <description>AXI Master2 data width. The value of this register is derived from the DMAC_M2_DATA_WIDTH parameter. Master2 data width should be equal to that of Master 1.
M2_DATA_WIDTH = log2(DMAC_DATA_WIDTH/32)
0x0 = 32 bits
0x1 = 64 bits 
0x2 = 128 bits
0x3 = Reserved</description>
              <bitRange>[17:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>M1_DATA_WIDTH</name>
              <description>AXI Master1 data width. The value of this register is derived from the DMAC_M1_DATA_WIDTH parameter. Master1 data width should be equal to that of Master 2.
M1_DATA_WIDTH = log2(DMAC_DATA_WIDTH/32)
0x0 = 32 bits
0x1 = 64 bits
0x2 = 128 bits
0x3 = Reserved</description>
              <bitRange>[15:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>S_DATA_WIDTH</name>
              <description>APB slave interface data width.The value of this register is derived from the DMAC_S_DATA_WIDTH parameter. The width is fixed to 32 bits for now.
S_DATA_WIDTH = log2(DMAC_DATA_WIDTH/32)
0x0 = 32 bits
0x1 = Reserved
0x2 = Reserved
0x3 = Reserved</description>
              <bitRange>[13:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NUM_MASTER_INT</name>
              <description>Number of master interface. The value of this register is derived from the DMAC_NUM_MASTER_INT parameter. This value is fixed to 1 (only 2 AXI masters supported now.)
0x0 = Reserved
0x1 = 2
0x2 = Reserved
0x3 = Reserved</description>
              <bitRange>[11:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NUM_CHANNELS</name>
              <description>Number of channels. The value of this register is derived from the DMAC_NUM_CHASNNELS parameter.
NUM_CHANNELS = DMAC_NUM_CHASNNELS -1
0x0 = 1
... 
0xf = 16</description>
              <bitRange>[9:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_IO</name>
              <description>Interrupt output format.The value of this register is derived from the DMAC_INTR_IO parameter.
0x0 = ALL
0x1 = TYPE
0x2 = COMBINED
0x3 = reserved</description>
              <bitRange>[1:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
