          <name>RSTACT</name>
          <addressOffset>0x000000C8</addressOffset>
          <size>32</size>
          <description>RSTACT Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTACT</name>
              <description>[31:24]: to store the defining byte previously received in Direct SET (contain 0x0-0x4). (auto_clear when receiving Start, not Sr) data for CCC.RSTACT direct get with def_byte = 0x0-0x3, 0x80
[23:16]: data for CCC.RSTACT direct get with def_byte = 0x83 (reserved)
[15:8]: data for CCC.RSTACT direct get with def_byte = 0x82 
[7:0]: data for CCC.RSTACT direct get with def_byte = 0x81
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
