          <description>Controller ASYN Timing Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ASYN_FAIL</name>
              <description>Indicate C_REF/C_C2 counter overflow</description>
              <bitRange>[31:31]</bitRange>
