              <description>Signature value 6 of LMOTS</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LMOTS_sig_alias256_7</name>
          <addressOffset>0x0000018C</addressOffset>
