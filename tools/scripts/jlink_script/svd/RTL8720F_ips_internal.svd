              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bit_adc_comp_ctrl_ch1</name>
              <description>the function is same as bit_adc_comp_ctrl_ch10</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
