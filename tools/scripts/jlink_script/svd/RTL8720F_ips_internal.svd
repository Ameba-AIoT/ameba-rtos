          <description>SEC region 6 end address register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEC_END6</name>
              <description>SEC region 6 end address[31:12].
This is 4KB aligned address.
Note: Available only if configuration of PSRAM_EN is defined.</description>
              <bitRange>[31:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SEC_R6_MODE</name>
              <description>SEC region 6 - function mode/seed selection.
Select one of mode/seed from SEC_NONCE0~SEC_NONCE7</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SEC_R6_EN</name>
              <description>Set to enable SEC region 6 to scramble write data and descramble read data.</description>
