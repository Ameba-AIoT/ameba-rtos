              <name>can_ram_data_2_2</name>
              <description>data_byte 4*2+2</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_2_1</name>
              <description>data_byte 4*2+1</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_2_0</name>
              <description>data_byte 4*2+0</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_FDDATA_1</name>
          <addressOffset>0x00000338</addressOffset>
          <size>32</size>
          <description>CAN data</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_data_1_3</name>
              <description>data_byte 4*1+3</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_1_2</name>
              <description>data_byte 4*1+2</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_1_1</name>
              <description>data_byte 4*1+1</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_1_0</name>
              <description>data_byte 4*1+0</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_FDDATA_0</name>
          <addressOffset>0x0000033C</addressOffset>
          <size>32</size>
          <description>CAN data</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_data_0_3</name>
              <description>data_byte 4*0+3</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_0_2</name>
              <description>data_byte 4*0+2</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_0_1</name>
              <description>data_byte 4*0+1</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_data_0_0</name>
              <description>data_byte 4*0+0</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_ARB</name>
          <addressOffset>0x00000340</addressOffset>
          <size>32</size>
          <description>CAN message buffer arb field configuration</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_rtr</name>
              <description>can frame RTR bit, determine DATA or REMOTE frame</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_ide</name>
              <description>can frame IDE bit, determine standard or extend format</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_id</name>
              <description>can frame ID, including high 11 bit standard ID and low 18 bit extend ID</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_MASK</name>
          <addressOffset>0x00000344</addressOffset>
          <size>32</size>
          <description>CAN message buffer arb field mask configuration</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_rtr_mask</name>
              <description>can frame RTR mask, 0 means don't care, 1 means the bit should match</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_ide_mask</name>
              <description>can frame IDE mask, 0 means don't care, 1 means the bit should match</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_id_mask</name>
              <description>can frame ID mask, 0 means the ID bit in CAN_RAM_ARB don't care, 1 means the bit should match.</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_CS</name>
          <addressOffset>0x00000348</addressOffset>
          <size>32</size>
          <description>CAN message type control</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_timestamp</name>
              <description>the received message time stamp</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_esi</name>
              <description>FD frame esi bit, indicate error passive of message sending node, read bit, should always write 0, hardware automatic fill</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_brs</name>
              <description>FD frame brs bit, indicate switch bit timing</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_edl</name>
              <description>FD frame edl bit, indicate it's a FD frame</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_autoreply</name>
              <description>set the message buffer with remote frame auto reply function</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_rxtx</name>
              <description>can frame RX or TX, 0 is for RX, 1 is for TX</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_lost</name>
              <description>data have lost in the read buffer, means more than one frame have beed received since last read; only avaliable when rx FIFO is disabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_dlc</name>
              <description>data length</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAN_RAM_CMD</name>
          <addressOffset>0x0000034C</addressOffset>
          <size>32</size>
          <description>CAN message buffer access control</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>can_ram_start</name>
              <description>start to exchange data with RAM, the bit will clear automatically after the data change is finshed.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_dir</name>
              <description>0 is for read from RAM to CAN_RAM_* registers, 1 is for write from CAN_RAM_* to RAM</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_buffer_en</name>
              <description>enable the can_ram_acc_num specified message buffer for rx/tx</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data15</name>
              <description>access CAN_RAM_DATA_15 field, the field will exchange with RAM space</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data14</name>
              <description>access CAN_RAM_DATA_14 field, the field will exchange with RAM space</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data13</name>
              <description>access CAN_RAM_DATA_13 field, the field will exchange with RAM space</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data12</name>
              <description>access CAN_RAM_DATA_12 field, the field will exchange with RAM space</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data11</name>
              <description>access CAN_RAM_DATA_11 field, the field will exchange with RAM space</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data10</name>
              <description>access CAN_RAM_DATA_10 field, the field will exchange with RAM space</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data9</name>
              <description>access CAN_RAM_DATA_9 field, the field will exchange with RAM space</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data8</name>
              <description>access CAN_RAM_DATA_8 field, the field will exchange with RAM space</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data7</name>
              <description>access CAN_RAM_DATA_7 field, the field will exchange with RAM space</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data6</name>
              <description>access CAN_RAM_DATA_6 field, the field will exchange with RAM space</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data5</name>
              <description>access CAN_RAM_DATA_5 field, the field will exchange with RAM space</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data4</name>
              <description>access CAN_RAM_DATA_4 field, the field will exchange with RAM space</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data3</name>
              <description>access CAN_RAM_DATA_3 field, the field will exchange with RAM space</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data2</name>
              <description>access CAN_RAM_DATA_2 field, the field will exchange with RAM space</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data1</name>
              <description>access CAN_RAM_DATA_1 field, the field will exchange with RAM space</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_data0</name>
              <description>access CAN_RAM_DATA_0 field, the field will exchange with RAM space</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_arb</name>
              <description>access CAN_RAM_ARB field, the field will exchange with RAM space</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>can_ram_acc_cs</name>
              <description>access CAN_RAM_CS field, the field will exchange with RAM space</description>
