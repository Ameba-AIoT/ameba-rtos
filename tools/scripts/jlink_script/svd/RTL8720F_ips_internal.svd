        <register>
          <name>CAN_DUMMY</name>
          <addressOffset>0x000003FC</addressOffset>
          <size>32</size>
          <description>dummy register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>dummy</name>
