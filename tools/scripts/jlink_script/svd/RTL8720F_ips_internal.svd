              <name>SEC_NONCE6</name>
              <description>Only present if SEC_CONF_MODE &gt; 0.
Seed of scrambler mode 6.
This register value cannot be 0, otherwise the encrypted data will be equal to the original data.
Note: Available only if configuration of PSRAM_EN is defined.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SEC_BASE_7</name>
          <addressOffset>0x00000254</addressOffset>
          <size>32</size>
