        <register>
          <name>REG_XTAL_CTRL</name>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x02200033</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WL_XTAL_REQ</name>
              <description>the xtal request mode of wifi</description>
              <bitRange>[25:23]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WL_XTAL_REQ_TRG</name>
              <description>1: wl request xtal status to active mode,which means selectl 0x30[6:5] as request
0: wl request xtal status to lps mode,which means selectl 0x30[4:3] as request</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_XTAL_REQ_ACT</name>
              <description>000:xtal off
001:xtal lps mode gating 40M
010:xtal lps mode enable 40M
011:xtal normal mode
100:xtal hp mode</description>
              <bitRange>[21:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_XTAL_REQ_LPS</name>
              <description>000:xtal off
001:xtal lps mode gating 40M
010:xtal lps mode enable 40M
011:xtal normal mode
100:xtal hp mode</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_MLDO_MODE_REQ_TRG</name>
              <description>Write 1 to trigger switch LDO mode when wifi is active, pulse</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_MLDO_MODE_REQ</name>
              <description>The ldo request mode of wifi</description>
              <bitRange>[5:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WL_MLDO_MODE_LPS</name>
              <description>00: analog LDO off   
01: analog LDO off sleep
10: analog LDO normal -- dummy load
11: analog LDO normal -- no dummy load</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_MLDO_MODE_ACT</name>
              <description>00: analog LDO off   
01: analog LDO off sleep
10: analog LDO normal -- dummy load
11: analog LDO normal -- no dummy load</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_WL_PMC_CTRL</name>
          <addressOffset>0x00000020</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00309F00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>wlbb_reset_by_pmc</name>
              <description>1: release wlbb glb reset and restore wlbb retention dff by wlpmc
0:release wlbb glb reset and restore wlbb retention dff by sw or hioe</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_bb_retain_en_type_1</name>
              <description>1 to 0:gen req to restore register in power on flow
0 to 1:gen req to backup register in power on flow
default should be 1,otherwise there be unexpected leakage power when VCC is power off and VCCG is still on</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_bb_save_en_type_2</name>
              <description>enable saving value of retention DFF when wlbb power off or pg,should be assert when reset is high</description>
              <bitRange>[19:19]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>WL_bb_restore_en_type_2</name>
              <description>enable restoring value of retention DFF when wlbb power on,should be assert when reset is high</description>
              <bitRange>[18:18]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>WL_save_en_type_2</name>
              <description>enable saving value of retention DFF when wlmac power off or pg,should be assert when reset is high</description>
              <bitRange>[17:17]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>WL_restore_en_type_2</name>
              <description>enable restoring value of retention DFF when wlmac power on,should be assert when reset is high</description>
              <bitRange>[16:16]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>WL_retain_en_type_1</name>
              <description>1 to 0:gen req to restore register in power on flow
0 to 1:gen req to backup register in power on flow
default should be 1,otherwise there be unexpected leakage power when VCC is power off and VCCG is still on</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_retention_cell_sel</name>
              <description>1:choose retention cell type I(U22 ULP),which is controlled by 0x20[15]
0:choose retention cell type II(RTKM),which is controlled by 0x20[17:16]</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_PMC_TUTIME</name>
              <description>WL PMC FSM counting unit.</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_PMC_LPS</name>
              <description>Inform WLAN PMC FSM to enter LPS mode. 
(auto clear when ready)</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_PMC_POFF</name>
              <description>Inform WLAN PMC FSM to power OFF mode, include clock, isolation, power control for MAC only (clear when Power Ready)</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_PMC_PON</name>
              <description>Inform WLAN PMC FSM to power On mode, include clock, isolation, power control for MAC only (clear when Power Ready)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
