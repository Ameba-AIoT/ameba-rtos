          <fields>
            <field>
              <name>RxRingSize2</name>
              <description>The total number of descriptors in the Rx descriptor rings of  queue. 
Act as bit mask, eg. RxRingSize [11:0]: 
0000_0000_1111:  16 descriptors 
0000_0001_1111:  32 descriptors 
0000_0011_1111:  64 descriptors 
0000_0111_1111:  128 descriptors 
0000_1111_1111:  256 descriptors 
0001_1111_1111:  512 descriptors 
0011_1111_1111:  1024 descriptors 
0111_1111_1111:  2048 descriptors 
1111_1111_1111:  4096 descriptors 
Any other value in this register yields undefined results.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
