    </peripheral>
    <peripheral>
      <name>PKE_REG</name>
      <baseAddress>0x40080000</baseAddress>
      <size>0x0000003C</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x0000003C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>PKE_Control</name>
          <addressOffset>0x00000000</addressOffset>
          <size>32</size>
          <description>PKE Control Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PKE_Control_HASH_READY</name>
              <description>Write 1 to inform PKE that hash value used in SIMPLIFY ECDSA/EDDSA are ready</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_START</name>
              <description>Write 1 to start PKE (cleared automatically by PKE)</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_OTHER_FUNCTION</name>
              <description>Other functions (not RSA/ECC) enable bit
1: enabled
0: disabled (RSA: modular exponentiation; ECC: scalar multiplication)</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_WORD_SWAP</name>
              <description>Endian word swap enable (only supported in MMEM)</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_BYTE_SWAP</name>
              <description>Endian byte swap enable (only supported in MMEM)</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_PRECOMPUTATION</name>
              <description>R^2 mod N ready (1 means not need to calculate the R^2 mod N, already stored by user)
For RSA , R^2 mod N ready and DPA defense can't be enabled at the same time. Valid only when bit[27] == 0</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_PRECISE_LENGTH</name>
              <description>Precise RSA/ECC length in bits
Caution: when preforming ecc point operation under binary field, there are situation which width of modulo is larger than ecc length. For example, width of f(x) of sect163r2 is 164, larger than ECC length 163. In this situation, just fill in Precise ECC length 163.</description>
              <bitRange>[23:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_MODE_MAIN</name>
              <description>2'b00: ECC Prime field
2'b01: ECC Binary field
2'b10: RSA
2'b11: Edwards or Montgomery Curves</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_MODE_CURVE</name>
              <description>1'b0: Edward Curves
1'b1: Montgomery Curves</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_USE_LFSR</name>
              <description>1: use internal LFSR0, and do not use internal LFSR. If user does not use internal LFSR, user needs to initial a 32-bit random number (can't be 0) to MMEM offset 0x600 (RSA3072), or MMEM offser 0x800 (RSA4096) or MMEM offset 0x380 (ECC). And if configured to ECC, please also clear the upper MMEM offset 0x381 to 0x3bf to 0.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_TIMING_ATTACK</name>
              <description>1: Timing attack defense enable
0: Timing attack defense disable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_DPA_DEFENSE</name>
              <description>1: DPA defense enable
0: DPA defense disable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_IMEM_READ</name>
              <description>1: Enable IMEM read (or else, the IMEM can only be read when bit[30] = 1)
0: IMEM can't be read</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Control_CAL_PRECOMPUTE</name>
              <description>When using RSA/ECC (bit 27 == 0), if this bit is set, PKE will calculate R ^ 2 mod N, n[63:0] ^ (-1) mod r only</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_Status</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description>PKE Status Register</description>
          <resetValue>0x00000100</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PKE_Status_HASH_NEED</name>
              <description>SIMPLIFY_ECDSA/EdDSA needs hash value</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PKE_Status_IDLE</name>
              <description>PKE idle</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>PKE_STATUS</name>
              <description>7'h1: prime check error(for modular number)
7'h2: R^2 mod N failed
7'h4: ECC odd point (Y = 0) (Montgomery curve will not check the Y value)
7'h5: RSA not supported
7'h6: check version error
7'h7: no such function
7'h8: ECC Z = 0
7'h10: Modular Inverse failed
7'h20: N &lt; input message for RSA
7'h40: No valid exponent</description>
              <bitRange>[7:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Status_FINISH</name>
              <description>PKE operation finish</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_Interrupt</name>
          <addressOffset>0x0000000C</addressOffset>
          <size>32</size>
          <description>PKE Interrupt Mask Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PKE_Interrupt_SIMPLIFY_HASH_MASK</name>
              <description>Wait for SIMPLIFY_ECDSA_EDDSA hash value
0: interrupt masked
1: interrupt not masked</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PKE_Interrupt_STATUS_MASK</name>
              <description>Interrupt mask for interrupt in PKE status register bit[7:0]
8'h00: interrupt masked
8'hff: interrupt not masked
Caution: valid value of this field is only 8'h00 or 8'hff</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_Swap</name>
          <addressOffset>0x00000014</addressOffset>
          <size>32</size>
          <description>Base addess of word swap Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>KEY_NUM</name>
              <description>Use which key (binary encoding), key0 ~ key7</description>
              <bitRange>[19:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>KEY_PORT_EN</name>
              <description>1: Enable hardware key port
0: Do not enable hardware key port</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SWAP_BASE</name>
              <description>Word swap base address in word (32 bits)</description>
              <bitRange>[10:2]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_Version</name>
          <addressOffset>0x0000001C</addressOffset>
          <size>32</size>
          <description>Version Number Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>VERSION</name>
              <description>32-bit code update date or version number , such as 32'h20211015</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LFSR_Seed</name>
          <addressOffset>0x0000002C</addressOffset>
          <size>32</size>
          <description>PKESeeding Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEED</name>
              <description>Seed of internal LFSRs</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_MUTEX</name>
          <addressOffset>0x00000034</addressOffset>
          <size>32</size>
          <description>PKE Mutex Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MUTEX_STATUS</name>
              <description>If read 0, lock mutex.
If not 0, the engine is being used.
2'b01: secure domain lock mutex
2'b10: non-secure domain lock mutex
Write 0 to unlock mutex</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PKE_MUTEX_OVERWRITE</name>
          <addressOffset>0x00000038</addressOffset>
          <size>32</size>
          <description>PKE Mutex Overwrite Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MUTEX_OVERWRITE</name>
              <description>Allows secure domain overwrite mutex
1: Enable
0: Disable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>WLON</name>
      <groupName>WIFI</groupName>
      <baseAddress>0x40000000</baseAddress>
      <size>0x000000A8</size>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>0x000000A8</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>REG_SYS_PWC_ISO_CTRL</name>
          <addressOffset>0x00000000</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x0000C8D0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WL_SWR_STS_REQ_ACT</name>
              <description>000: RSVD 
001: state1  0.7/PC/PFM
010: state2  0.8/PC/PFM 
011: state3  0.9/PC/PFM
100: state4  0.9/SLP/PFM 
101: state5  0.9/SLP/PWM 
110: state6  0.9/NORM/PWM 
111: state7  1.0/NORM/PWM</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_SWR_STS_REQ_LPS</name>
              <description>000: RSVD
001: state1  0.7/PC/PFM
010: state2  0.8/PC/PFM 
011: state3  0.9/PC/PFM
100: state4  0.9/SLP/PFM
101: state5  0.9/SLP/PWM 
110: state6  0.9/NORM/PWM 
111: state7  1.0/NORM/PWM</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_SWR_STS_REQ_TRG</name>
              <description>1:wl request switch regu status to active mode,which means selectl 0x00[11:9] as request
0:wl request switch regu status to lps mode,which means selectl 0x00[7:5] as request</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_SWR_STS_REQ</name>
              <description>the SWR request mode of wifi</description>
              <bitRange>[7:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WL_PWR_SWITCH_DMY_EN</name>
              <description>1:enable wl dummy load when wlan is switching power mode
0:disable wl dummy load when wlan is switching power mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_POW_AFE_REQ</name>
              <description>AFE power on request to afe_ctrl
1:request to turn on AFE pwr
0:turn off AFE pwr</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_REQ_TO_ACT</name>
              <description>notify system to act</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_PWC_WLMAC_EN</name>
              <description>1: Enable WLOFF power cut</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_WL_CLK_CTRL</name>
          <addressOffset>0x00000002</addressOffset>
          <size>16</size>
          <description></description>
          <resetValue>0x00008000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BT_EN_WL_CK4M</name>
              <description>enable WL OSC 4M when bt is active</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WLON_SWITCH_TSF_EN</name>
              <description>enable wlpmc switch TSF clock to MAC clock</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WLOFF_SWITCH_TSF_EN</name>
              <description>enable wlpmc switch TSF clock to 32K clock</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKEN_IQDUMP</name>
              <description>0: disable clock for iqdump (LA MODE)
1: enable clock for iqdump (LA MODE)
same clock source as security clock</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TSF_IS_32K</name>
              <description>WL TSF clock status:
0: MAC clock
1: 32K clock</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>WL_CKSL_CKTSF</name>
              <description>1: TSF clock switch to 32.768KHz; 0: TSF clock switch to MAC clock</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKTSF1_EN</name>
              <description>1: enable port2 tsf clock; 0: gated</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKTSF0_EN</name>
              <description>1: enable port1 tsf clock; 0: gated</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_FQSEL_CK32K</name>
              <description>1:32K frequency select 32.768KHz 0:32K frequency select 32KHz</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CK32K_EN</name>
              <description>1: enable 32k clock; 0: gated</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKSEC_EN</name>
              <description>1: enable MAC security engine clock; 0: gated</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKMAC_EN</name>
              <description>1: enable MAC clock; 0: gated</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_WL_FUNC_EN</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x06000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WL_PON_WAIT_ALL</name>
              <description>1:wait rdy for swr and xtal and pwc in the same state when power on to save time and power</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_POF_WAIT_ALL</name>
              <description>1:wait rdy for swr and xtal in the same state when power off to save time and power</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_SEL_SW_SI</name>
              <description>indicate SW use indirect path to access WLRFC register</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FEN_BB_RSTB</name>
              <description>When this bit is set to 0, CCK and OFDM are disabled, and clock are gated. Otherwise, CCK and OFDM are enabled.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FEN_BB_GLB</name>
              <description>When this bit is set to 0 whole BB is reset. When this bit is set, BB is enabled.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FW_INIT_RDY</name>
              <description>CPU fw initialize ready, set by CPU(txrpt info update,used in ptcl)</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_FEN_WLON</name>
              <description>1: enable WL partial ON; 0: reset</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_FEN_WLOFF</name>
              <description>1: enable WLOFF; 0: reset</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_FEN_MAC_PMC</name>
              <description>1: enable MAC PMC; 0: reset</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CLKDIV_CKSEL</name>
          <addressOffset>0x00000008</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00040000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SW_EN_WL_CK4M</name>
              <description>enable WL OSC 4M when cpu want to access wlon reg and wlpmc buffer</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SEC_CLK_SEL</name>
              <description>11/10:40M
01:80M
00:160M</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MAC_CLK_SEL</name>
              <description>11/10:20M
01:40M
00:80M</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_CKDIV_SYNC_1SHOT</name>
              <description>1: sync 40M/80M clock  phase with PLL</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WL_MAC_PHASE</name>
