          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>bpc_bt</name>
              <description>Select IP controller source : bt
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_wl</name>
              <description>Select IP controller source : wl
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_psram</name>
              <description>Select IP controller source : psram
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_spic</name>
              <description>Select IP controller source : spic
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_cpu1</name>
              <description>Select IP controller source : cpu1
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_cpu0</name>
              <description>Select IP controller source : cpu0
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_swrst</name>
              <description>Select IP controller source : rst
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_pmc</name>
              <description>Select IP controller source : pmc
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>bpc_qspi</name>
              <description>Select IP controller source : qspi
1:control by nonsec zone
0:control by secure zone</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pcr_prot_k3</name>
              <description>Retention Mem last forth 256 bit protect
0: read and write , 
1 : read only</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pcr_prot_k2</name>
              <description>Retention Mem last third 256 bit protect
0: read and write , 
1 : read only</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pcr_prot_k1</name>
              <description>Retention Mem last second 256 bit protect
0: read and write , 
1 : read only</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pcr_prot_k0</name>
              <description>Retention Mem last 256 bit protect (located in last 256bit of retention memory)
0: read and write , 
1 : read only</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_aret</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_wdg</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_mmu</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_mem</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_pad</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both
Note:this control both of pinmux and ledc, for they are in same reset domain.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_rtc</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
[1]: rd prot ctrl , 0:secure only , 1:both</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ppc_sdm</name>
              <description>IP slave port R/W secure ctrl
[0]: wr prot ctrl ,   0: secure only , 1: both
