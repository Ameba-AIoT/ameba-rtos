            </field>
          </fields>
        </register>
        <register>
          <name>SEC_NONCE_6</name>
          <addressOffset>0x00000250</addressOffset>
          <size>32</size>
          <description>SEC region 6 nonce register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
