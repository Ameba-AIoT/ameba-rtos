*available after version 2024/08/19</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_ende_circuit_status</name>
              <description>Masked error_ende_circuit.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_decode_cipher_status</name>
              <description>Masked error_decode_cipher.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>error_block_size_status</name>
              <description>Masked error_block_size.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>aes_slave_done_status</name>
              <description>Masked aes_slave_done.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn0_aes_int_clear</name>
          <addressOffset>0x00000EFC</addressOffset>
          <size>32</size>
          <description>Clear interrupt register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>aes_int_clear</name>
              <description>Interrupt clear.
Writing 1'b1 to the register will trigger a 1-cycle pulse interrupt clear.</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn_aes_mask_en_and_version</name>
          <addressOffset>0x00000FF0</addressOffset>
          <size>32</size>
          <description>Enable AES engine mask status register and version register</description>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>version</name>
              <description>The lalu_aes version number.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_en</name>
              <description>Indicate whether DMA is used (suppoty DMA mode or not)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>core_select_lock</name>
              <description>Indicate whether the core_select was locked by hardware pin.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>key_management_en</name>
              <description>Indicate whether to use key_management.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>trustzone_en</name>
              <description>Indicate whether to use TrustZone.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gf_mask_en</name>
              <description>Indicate whether to use SCA countermeasure.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn_aes_en_de_circuit</name>
          <addressOffset>0x00000FF4</addressOffset>
          <size>32</size>
          <description>Enable circuit status register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>en_circuit</name>
              <description>Indicate which AES engine has the encryption circuit.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>de_circuit</name>
              <description>Indicate which AES engine has the decryption circuit.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>chn_aes_gcm_xts_circuit</name>
          <addressOffset>0x00000FF8</addressOffset>
          <size>32</size>
          <description>Enable GCM and XTS status register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>xts_circuit</name>
              <description>Indicate which AES engine has the XTS circuit.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gcm_circuit</name>
              <description>Indicate which AES engine has the GCM and GMAC circuit.</description>
