            <field>
              <name>EN_FTMRPT</name>
              <description>When this bit asserted, HW will report FTM rpt</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RD_FTMT2R_ERR</name>
              <description>Indicates the timeout error in FTM t2r report</description>
              <bitRange>[22:22]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TXRPT_NUM_THRS</name>
              <description>if the number of txrpt exceeds the threshold,then assert txrpt interrupts</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXRPT_DIS</name>
              <description>when this bit is enabled, HW will not generate txrpt for driver's fixed rate packets</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIS_TXFAIL_RPT</name>
              <description>when this bit is enabled, HW will not generate txrpt for tx failed packets</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_BCN_TRXRPT</name>
              <description>when this bit is enabled, HW will generate txrpt for BCN</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXRPT_QUEUE_EN</name>
              <description>1: HW will report tx_status  0: no report
BIT0: BK Queue
BIT1: BE Queue
BIT2: VI Queue
BIT3: VO Queue
BIT4: MGT Queue
BIT5: HG Queue
BIT6: BCN Queue
BIT7: TB Queue
BIT8: EVENT QUEUE</description>
              <bitRange>[8:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
