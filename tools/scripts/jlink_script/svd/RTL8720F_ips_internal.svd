            </field>
            <field>
              <name>HE_TB_PPDU_ONLY_EN</name>
              <description>asserted if the TWT is trigger-enabled TWT</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TB_TXPAUSE</name>
              <description>valid if BIT_HE_TB_PPSU_ONLY_EN = 1; select pause edca or not during TWT-SP; default is 1, pause.
A TWT requesting STA should not transmit frames to the TWT responding STA outside of negotiated TWT SPs and should not transmit frames that are not contained within HE TB PPDUs to the TWT responding STA within trigger-enabled TWT SPs</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIS_UPD_BEAM_CHG</name>
              <description>1: txcmd_beam_change TIE 0
0: first PPDU in TXOP will assert txcmd_beam_change</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SET_MUEDCATIMER_TF</name>
              <description>1: enable HW updating MUEDCATimer after Tx HE TB PPDU
0: disable HW updating MUEDCATimer after Tx HE TB PPDU</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MUEDCA_EN</name>
              <description>1: enable HW updating MUEDCATimer
0: disable HW updating MUEDCATimer</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_CCA_NAV_CHK</name>
          <addressOffset>0x00000574</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000F3F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SR_CTN_CHK_NAV</name>
              <description>When BASIC or INTRA NAV &gt; 0  in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SR_CTN_CHK_ZGBTCCA</name>
              <description>When  ~GNT_WL(BT/ZigBee)  assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SR_CTN_CHK_EDCCA</name>
              <description>When EDCCA assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SR_CTN_CHK_CCA_S20</name>
              <description>When EDCCA assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_INTRA_NAV</name>
              <description>When INTRA NAV &gt; 0  in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_BASIC_NAV</name>
              <description>When BASIC NAV &gt; 0  in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_ZGBTCCA</name>
              <description>When ~GNT_WL(BT/ZigBee) assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_EDCCA</name>
              <description>When EDCCA assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_CCA_S20</name>
              <description>When SECONDARY_CCA_20 assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Can backoff, cannot TX</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTN_CHK_CCA_P20</name>
              <description>When CCA assert in the AIFS/Backoff before active TX
0: Can backoff, can TX
1: Cannot backoff, cannot TX</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_POF_BCNELY_AGG_TBTT</name>
          <addressOffset>0x00000578</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000003</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DUMMY</name>
              <description></description>
              <bitRange>[31:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_P0_TBTT_CNT</name>
              <description>enable the tbtt counter function.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P0_TBTT_CNT_THRS</name>
              <description>P0's TBTT counter threshold . Valid when  BIT_EN_P0_TBTT_CNT = 1. when tbtt_cnt &gt;= BIT_P0_TBTT_CNT_THRS, assert p0_tbtt_agg_int. UNIT: 16</description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_POF_ELY_AGG</name>
              <description>update bcn_ely_agg initial value of P0 to BIT_INI_POF_ELY_AGG_CNT
1: enable
0: disable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INI_POF_ELY_AGG_CNT</name>
              <description>bcn_ely_agg initial value of P0. Valid when BIT_EN_POF_ELY_AGG = 1</description>
              <bitRange>[4:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_LPSOFFLOAD_RXBCN_DIFF_CFG0</name>
          <addressOffset>0x0000057C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x07010040</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EN_TSFT_AVG_CAL</name>
              <description>1: calculate the average value of deltaTSFT(latch hioe_int_chn_on and  cca_up) in specified period</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_BCNELY_LATCH_TSFT</name>
              <description>1: latch TSFT to BIT_TSFT_AT_HIOE_RFON (0x153C) when P0's bcn_early int asserted</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TSFT_AVG_CAL_PRD</name>
              <description>2^(BIT_TSFT_AVG_CAL_PERIOD), default is 128 times</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TSFT_AVG_GT_THRES_CNT_MAX</name>
              <description>The max times of the BIT_TSFT_AVG_VALUE greater than BIT_TSFT_AVG_THRES, if the BIT_TSFT_AVG_VALUE exceeds the BIT_TSFT_AVG_THRES several times in a row, and the number exceeds the BIT_TSFT_AVG_GT_THRES_CNT_MAX, generate an interrupt</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TSFT_AVG_THRES</name>
              <description>The threshold of deltaTSFT(latch hioe_int_chn_on and  cca_up), unit 32us</description>
              <bitRange>[6:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_TSFT_AVG_VALUE</name>
          <addressOffset>0x00000580</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x06400000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GNT_BT_CNT</name>
              <description>WIFI TX shall wait settle time when antenna is switched from BT to WIFI/RADAR, if the BT use the same RFAFE as WIFI.
Unit: 1us</description>
              <bitRange>[31:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TSFT_AVG_GT_THRES_CNT</name>
              <description>statistic the times of the BIT_TSFT_AVG_VALUE than BIT_TSFT_AVG_THRES</description>
              <bitRange>[19:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TSFT_AVG_VALUE</name>
              <description>the average value of deltaTSFT(latch hioe_int_chn_on and  cca_up) in specified period</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_NAN_P2_CFG0</name>
          <addressOffset>0x00000584</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x12000064</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DUMMY</name>
              <description></description>
              <bitRange>[31:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FCSOK_CHK_BSSID</name>
              <description>1:HW will check bssid when fcsok</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BCNSPACE_P2_1</name>
              <description>Unit is ms. the beacon space of port2 sync beacon. default is 512ms</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BCNSPACE_P2_0</name>
              <description>Unit is ms. the beacon space of port2 disc beacon. default is 100ms</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_NAN_P2_CFG1</name>
          <addressOffset>0x00000588</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00058082</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>P2_TSFT_BACKUP_EN</name>
              <description>1:en tsft backup</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>UPD_TSFT_DIS_CHK_TA</name>
              <description>1: don't check TA_FIT when update NAN tsft</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ELY_32US_P2</name>
              <description>the BCN EARLY interrupt find tune with unit 32us. The Total Early time of BCN early interrupt is the ERLYINTTIM x 1ms - EARLY_32us x 32us.</description>
              <bitRange>[29:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ERLYINTTIM_P2</name>
              <description>Time to send interrupt to notify driver to change beacon content. Time unit is TU.
It is used to wake up early at DriverEarlyTime</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BCN_OFFSET_5G_NAN</name>
              <description>Unit is ms. the tbtt offset between 2.4G sync beacon and 5G sync bcn. Default is 128ms</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P2_TSFT_AUTO_SYNC_EN</name>
              <description>1: enable HW auto tsft sync, when sync beacon frames are received, auto update RX.timestamp + RX path delay to TSFT_P2_0</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SW_SYNC_P2_TSFT</name>
              <description>When write this bit, TSFT P2_0 will sync to TSFT P2_1 without TSFTF_SYN_OFFSET, need co-work with BIT_P2_DIS_TSF_UPT = 1</description>
              <bitRange>[6:6]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>P2_TSFT_RST</name>
              <description>write this bit, bcn2 tsft will reset to 1</description>
              <bitRange>[5:5]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>P2_DIS_BCN</name>
              <description>set 1 to mask the beacon early interrupt of port2
[0]: for NAN disc beacon
[1]: for NAN sync beacon</description>
              <bitRange>[4:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P2_DIS_RX_BSSID_FIT</name>
              <description>0:HW will handle rx_beacon 1:HW will ignore rx_beacon_pk</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P2_DIS_TSF_UPT</name>
              <description>When set, disable clint 2 TSF update when beacon frames or probe response frames are received.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>P2_EN_BCNQ</name>
              <description>When this bit is set, TSF and other beacon related functions are then enabled.
BIT_P2_EN_BCNQ = 1 also means turning on the NAN feature</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_NAN_CFG</name>
          <addressOffset>0x0000058C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x102D0161</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TBTT_HOLD_PREDICT</name>
              <description>the predicted hold time after tbtt for P0 RX beacon, unit is 1ms</description>
              <bitRange>[31:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SYNCBCN_DELAY</name>
              <description>r_HC * r_SLOTTIME * 8'd40 (unit:us)
default: r_HC = 1, r_SLOTTIME = 9, =&gt; 360us
max is 16ms (DW)</description>
              <bitRange>[26:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>NAN_ROLE</name>
              <description>the role of NAN device: 
2'b00: master
2'b01: no-master sync
2'b10: no-master no-sync.</description>
              <bitRange>[12:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BCN_PORT_PRI</name>
              <description>the priority of ports 
000: no priority
001: port2 sync bcn has higher priority than P0/P1, P2 sync &gt; P0/P1
010: port0 has higher priority than P2 sync bcn, P0 &gt; P2 sync &gt; P1
011: port1 has higher priority than P2 sync bcn, P1 &gt; P2 sync &gt; P0
100: port0 and port1 has higher priority than P2 sync bcn, P0/P1 &gt; P2 sync</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_PORT_ROND</name>
              <description>1: enable round-robin of P2 disc beacon and P0/1 beacon</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TBTT_INT_CLR_P2_BCNREQ</name>
              <description>1: tbtt int can clear bcnely_req when arbitration fail</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EVTQ_VLD</name>
              <description>1: enable EVTQ TX</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_5G_NAN</name>
              <description>1: enable 5G NAN mode
0: only 2.4G NAN</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EVTQ_EARLY</name>
              <description>the early time of evtq tx window. unit is TU</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>REG_EDCA_REF_CFG</name>
          <addressOffset>0x00000590</addressOffset>
