          <size>32</size>
          <description>DEVCTRL Register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DEVCTRL3</name>
              <description>Byte 3 Data payload for CCC.DEVCTRL; when IPCR.INTEL = 1 or JESD =1
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[31:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>DEVCTRL2</name>
              <description>Byte 2 Data payload for CCC.DEVCTRL; when IPCR.INTEL = 1 or JESD =1
Exists: TAG &gt;= 2.1.0</description>
              <bitRange>[23:16]</bitRange>
