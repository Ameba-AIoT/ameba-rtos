        <register>
          <name>REG_UVC_CHNL0_CTRL</name>
          <addressOffset>0x00000004</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ch0_dma_addr</name>
              <description>For checking ahb xfer with header, this value should be the same as HCDMAi in otg_core</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
