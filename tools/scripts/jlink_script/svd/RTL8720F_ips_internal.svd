            <field>
              <name>ISR_RDU6</name>
              <description>Rx Descriptor Unavailable for RING6: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RDU5</name>
              <description>Rx Descriptor Unavailable for RING5: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RDU4</name>
              <description>Rx Descriptor Unavailable for RING4: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RDU3</name>
              <description>Rx Descriptor Unavailable for RING3: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RDU2</name>
              <description>Rx Descriptor Unavailable for RING2: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_SWInt</name>
              <description>Software Interrupt pending: 
When set to 1 indicates a software interrupt was forced.  
Write 1 to clear.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_TDU</name>
              <description>Tx Descriptor Unavailable: 
When set, indicates Tx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_LinkChg</name>
              <description>Link Change:  
Write 1 to clear.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_TER</name>
              <description>Transmit (Tx) Error: 
Indicates that a packet transmission was aborted, due to excessive collisions, according to the TXRR's setting.  
Write 1 to clear.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_TOK_TI</name>
              <description>Transmit Interrupt:  
Indicates that the DMA of the last descriptor of TxIntMitigation number of Tx packet has completed and the last descriptor has been closed. 
Write 1 to clear.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RDU1</name>
              <description>Rx Descriptor Unavailable for RING1: 
When set, indicates Rx descriptor is unavailable. 
Write 1 to clear.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RER_OVF</name>
              <description>Rx FIFO Overflow, caused by RBO/RDU, poor system bus (Lexra bus) performance, or overloaded Lexra bus traffic. 
Write 1 to clear.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_RER_RUNT</name>
              <description>Rx error caused by runt error characterized by the frame length in bytes being less than 64 bytes.
Write 1 to clear.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_CNT_WRAP</name>
              <description>Tx/rx counter wrap interrupt.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ISR_ROK</name>
              <description>Receive (Rx) OK:  This interrupt is set either when RxIntMitigation packet is met or RxPktTimer expires.
Write 1 to clear.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TCR</name>
          <addressOffset>0x00000040</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IFG2_0</name>
              <description>InterFrameGap Time: This field allows the user to adjust the interframe gap time longer than the standard: 9.6 us for 10Mbps, 960 ns for 100Mbps. The time can be programmed from 9.6 us to 14.4 us (10Mbps) and 960ns to 1440ns (100Mbps).  The formula for the inter frame gap is:
 IFG[2:0]    IFG@1000MHz (nS)   IFG@100MHz (nS)  IFG@10MHz (uS)
 0  1  1        96                           960                         9.6
 1  0  0        96 +8 * 1                 960 +8 * 10              9.6 +8 * 0.1
 1  0  1        96 + 16 * 1               960 + 16 * 10           9.6 + 16 * 0.1
 1  1  0        96 + 24 * 1               960 + 24 * 10           9.6 + 24 * 0.1
 1  1  1        96 + 32 * 1               960 + 32 * 10           9.6 + 32 * 0.1
 0  0  0        96 + 40 * 1               960 + 40 * 10           9.6 + 40 * 0.1
 0  0  1        96 + 48 * 1               960 + 48 * 10           9.6 + 48 * 0.1
 0  1  0        96 + 96 * 1               960 + 96 * 01           9.6 + 96 * 0.1</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LBK</name>
              <description>The loopback function must be independent of the link state. 
2'b00 : normal operation 
2'b01 : Loopback mode_R2T(lbkmode_r2t) :
     Lbk methld: no SW requirement.
               1. receive ingress data.
               2. assign rxd to txd (txd).
               3. egress pkt. b10 : Reserved 
2'b11 : Loopback mode(lbk_mode).
       Lbk method: 1. rx fet descriptor. 
                          2. tx fet descriptor and data
                          3. put data in txfifo
                          4. assign txd to rxd.(lbk)
                          5. gmac mv data to lxb. 
In this mode(lbk_mode), the recommended value of RC_REG(0x44) is 0xf.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCR</name>
          <addressOffset>0x00000044</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HomePNA</name>
              <description>Home PNA mode</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AFlow</name>
              <description>Accept flow control : 
When set to 1, flow control packet will also be received &amp; DMA to rx buffer for debug. Default is 0.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AER</name>
              <description>Accept Error Packet:  
When set to 1, all packets with CRC error, alignment error, and/or collided fragments will be accepted.
      Rxerrc keeps,
      Rxokc +1,
      Rx status dsc.CRC =1,
      Rx status dsc.RCDF =0. 
When set to 0, all packets with CRC error, alignment error, and/or collided fragments will be rejected.
      Rxerrc +1,
      Rxokc keeps,
      Rx status dsc.CRC =0,
      Rx status dsc.RCDF =1.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AR</name>
              <description>Accept Runt: This bit allows the receiver to accept packets that are smaller than 64 bytes. The packet must be at least 8 bytes long to be accepted as a runt. Set to 1 to accept runt packets.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AB</name>
              <description>Set to 1 to accept broadcast packets, 0 to reject.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AM</name>
              <description>Set to 1 to accept multicast packets, 0 to reject. RC_REG.AB and AM should be enabled simulatanously.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>APM</name>
              <description>Set to 1 to accept physical match packets, 0 to reject.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AAP</name>
              <description>Set to 1 to accept all packets with physical destination address, 0 to reject.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CPUTAG</name>
          <addressOffset>0x00000048</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x01400000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CTEN_RX</name>
              <description>Enable parsing ingress packet with cputag format.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_TSIZE</name>
              <description>Cputag size in egress pkt. 
CTT_size: 4'h0: 0 Byte
               4'h1: 4 Byte
               4'h2: 8Byte
               4'h3: 12 Byte</description>
              <bitRange>[30:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_RSIZE_3_2</name>
              <description>After rl8681 (including), this field is only for ingress pkt. 
CTR_size:  4'h0: 0 Byte
                 4'h1: 4 Byte
                 4'h2: 8Byte F
or Apollo cputag with PTP timestamp, set CT_RSIZE to h2.</description>
              <bitRange>[26:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_DSLRN</name>
              <description>In rtl8370s, Setting of Disable Learning field in tx cputag. 
Setting of Disable Learning field in RTL8368 or DSLRN field in RTL8307h tx cputag when short_dsc_format = 0.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_NORMK</name>
              <description>Setting of NORMK field in RTL8307h tx cputag when short_dsc_format = 0.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_ASPRI</name>
              <description>In RTL8307h, setting ASPRI field in tx cputag when short_dsc_format = 0. 
In RTL8370S, setting priority select field in tx cputag when short_dsc_format =0..</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_SWITCH</name>
              <description>Support cputag format of switch 
0: no cputag support 
1: 8368 
2: 8306 
3: 8307 
4: 8370 
5: gmac in 8681. 
6: gmac in Apollo,  rle0371, rl6266 and   rtl9601(rle0639)</description>
              <bitRange>[21:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CT_RSIZE_1_0</name>
              <description></description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTPM</name>
              <description>CPU tag protocol mask. 
8306:0xf0 
8368:0xe0 
8370:0xff 
8307h:0xff</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTPV</name>
              <description>CPU tag protocol value. 
8306:0x90 
8368:0xa0 or 0xb0 
8370:0x04 
8307h:0x04</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIG</name>
          <addressOffset>0x0000004C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x20000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Rff_size_sel</name>
              <description>Set gmac_rxfifo size. 
2'b00: 1KB 
2'b01: 1664B 
2'b10: 2KB</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>r_tso_id_sel</name>
              <description>0: each ID of IP header is same as original ID. 
1: increment 1 from original ID. Default value is 0.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>r_mdslv_outedge</name>
              <description>this bit works only  in phy_mode
0: change mdio output data in falling edge 
1: change mdio output data in rising edge</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>En_int_route</name>
              <description>0: disable interrupt routing, IMR0_reg, IMR1_reg. 
1: enable interrupt routing, IMR0_reg, IMR1_reg.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>En_int_split</name>
              <description>When, en_int_route = 0,
0: only int.tdu, tok and rok present. 
1: IMR0_reg, IMR1_reg and ISR1_reg present.   
When en_int_route = 1, this field is 1.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CPUTAG1</name>
          <addressOffset>0x00000050</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Spa_dsl</name>
              <description></description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Spa_pon</name>
              <description>The ingress cputag.SPA=PON field. Used in Apollo cputag.</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MSR</name>
          <addressOffset>0x00000058</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x000380C1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Force_TRXFCE</name>
              <description>Force Tx/RX Flow Control:  
1 = enabled Flow control in the absence of NWAY. 
0 = disables Flow control in the absence of NWAY. 
Version effect: rl6166(ECO) and after.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RXFCE</name>
              <description>RX Flow control Enable: The flow control is enabled in full-duplex mode only. 
Packets are dropped if buffer is exhausted.  Default is 0.   
1 = Rx Flow Control Enabled. 
0 = Rx Flow Control Disabled.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TXFCE</name>
              <description>Tx Flow Control Enable: 
1 = tx flow control enabled. 
0 = tx flow control disabled. 
ACCEPT ERROR MUST NOT BE ENABLED</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SPEED</name>
              <description>{SPEED_1000, SPEED_10} 
00: 100Mbps,   
01: 10Mbps
10: 1000Mbps,  
11: not allowed</description>
              <bitRange>[28:27]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>LINKB</name>
              <description>Inverse of Link status. 
0 = Link OK. 
1 = Link Fail.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>TXPF</name>
              <description>Tx Pause frame:  
1 = Ethernet module has sent a pause packet.  
0 = the Ethernet module has sent a timer done packet.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RXPF</name>
              <description>Pause Flag:  
1 =  Ethernet module is in backoff state because a pause packet received.  
0 = pause state is clear.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEL_RGMII</name>
              <description>gmac_sel_rgmii</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FULLDUPREG</name>
              <description>Indicates Full duplex mode from mdio results.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>NWCOMPLETE</name>
              <description>Nway complete</description>
              <bitRange>[21:21]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>SEL_MII</name>
              <description>indicates in mii mode.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>FORCEDFULLDUP</name>
              <description>force gmac operates at full duplex mode.  
This bit is Write only in RLE0315. 
This bit is R/W in RLE0390 (原RL6166). 
1'b1: force gmac in full duplex mode. 
1'b0: duplex status is from MDIO auto-polling. 
Not means gmac is in half duplex mode.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FORCELINK</name>
              <description>force gmac in link ok mode.  
This bit is Write only in RLE0315. 
This bit is R/W in RLE0390 (RL6166). 
1'b1: force gmac in linkok. 
1'b0: link status is from MDIO auto-polling.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FORCE_SPD</name>
              <description>Force gmac in 10/100/GIGA mode. 
2'b00: 100M  
2'b01: 10M 
2'b10: GIGA 
2'b11: not force mode. 
These bits are Write only in RLE0390 (RL6166). The current speed status of gmac can be checked in MSR_reg.{speed1000, speed_10}.  
In force mode, SW can set gmac operates in , FD and Link ok(for example) and SW can not set gmac operates in , HD and Link ok. When FORCEDFULLDUP is b0, the duplex status is from MDIO auto-polling, therefore, it is not controlled by SW.</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gmac_sel_phyif_0</name>
              <description>1: phy interface 0.works. 
0: phy interface 1 works.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>gmac_phy_mode</name>
              <description>1: in phy mode. (bit[6] will be read as '0') 
0: not in phy mode. (bit[6] will be read as '1')</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rgmii_rx_decode_sts</name>
              <description>0: Does not support rgmii in band status(link status, speed and duplex mode of the PHY) by decoding rxd. 
1: Supports rgmii in band status(link status, speed and duplex mode of the PHY) by decoding rxd.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rgmii_tx_encode_sts</name>
              <description>This field is valid only in phy mode.  
0: Does not support rgmii in band status(link status, speed and duplex mode of the PHY) by encoding txd. 
1: Supports rgmii in band status(link status, speed and duplex mode of the PHY) by encoding txd.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>force_spd_mode</name>
              <description>1: gmac is in force speed mode. The real speed in force mode is set in MS_REG.FORCE_SPD. 
0: gmac speed status is from md operation.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Eee_aby</name>
              <description>Indicates eee ability of PCS. 
Eee_aby[0]: eee ability in 100M 
Eee_aby[1]: eee ability in giga mode.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>reg_rmii2mii_en</name>
              <description>1: transfer MII signals to RMII signals 
This function is only valid in MII mode.
 (default 0: for AmebaI//AmebaPro/AmebaPro2)</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>gmac_md_mst</name>
              <description>1: GMAC is used to be MDIO master. (When bit[13] is setting as '0') 
0: GMAC is used to be MDIO slave. (When bit[13] is setting as '1')</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>refclk_phase</name>
              <description>1: for Tx transaction, TXEN &amp; TXD signals are changed on the falling edge of REF_CLK; for Rx transaction, RXD signals are sampled on the falling edge of REF_CLK
0: for Tx transaction, TXEN &amp; TXD signals are changed on the rising edge of REF_CLK; for Rx transaction, RXD signals are sampled on the rising edge of REF_CLK</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>refclk_on</name>
              <description>1: REF_CLK on 
0: REF_CLK off</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MIIAR</name>
          <addressOffset>0x0000005C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x04000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>Flag</name>
              <description>Flag bit, used to identify access to MII register: 
1:  Write data to MII register.  Turns to 0 automatically upon completion of MAC writing to the specified MII register. 
0:  Read data from MII register.  Turns to 1 automatically upon completion of MAC reading the specified MII register.   
Read write turn around time I s about 64 us.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PHYAddress</name>
              <description>Defines the Phy address for the MII.</description>
              <bitRange>[30:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>mdio_busy</name>
              <description>MDIO is busy</description>
              <bitRange>[25:25]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>En_eeep_auto_write</name>
              <description>HW auto writes PCS.page4.reg20 and reg27 to adjust analog parameters based on eeep_lpi state.  
SW should change page to page4 then set MIIA_REG.en_eeep_auto_write.  HW will write eeep_abig_on/off and eeep_ldvbias_on/off (in EEEP_CR6_REG and EEEP_CR7_REG) to PCS.page4.reg20 and reg27, respectively, based on eeep_lpi state.    
If SW wants to access another page of PCS, SW should disable MIIA_REG.en_eeep_auto_write.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Disable_auto_polling</name>
              <description>Disable auto polling feature of mdio operation. 
0: HW auto polling PCS status.  
1: HW does not auto polling PCS status.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>polling_eee_reg</name>
              <description>polling PCS EEE advertisement register (7.60). In rl6166(原rle0315) and before: this bit is not supported. 
In rle0390: In in-direct method, gmac had to access PCS register by multiples R/W of reg13 and 14. It is OK for PCS to be aborted in the middle of indirect method. 
In rle0371: HW will complete current indirect access to PCS then stop in-direct method.  Please refer to EEE_CR1_reg.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RegAddr4_0</name>
              <description>Defines 5-bit MII register address.</description>
              <bitRange>[20:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Data15_0</name>
              <description>Defines 16 bit MII resgister data.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SWINT</name>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SWINT</name>
              <description>Write 1 will force ISR register bit 10 set to 1</description>
              <bitRange>[24:24]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>VLAN_REG</name>
          <addressOffset>0x00000064</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x88A80000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>STAG_PID</name>
              <description>Set the s-tag protocol identifier. This field is valid only when COM_REG.TDSC_VLAN_TYPE is high.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TDSC_VLAN_TYPE</name>
              <description>1: tx command descriptor.tx_vlan_action is for s-tag. 
0: tx command descriptor.tx_vlan_action is for c-tag.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LED_CTRL</name>
          <addressOffset>0x00000070</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>eee_en_led</name>
              <description>Enable/disable lpi led.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Custom_led</name>
              <description>Custom led mode. 1: using custom led matrix table. 0: using Non-custom led table.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ledsel</name>
              <description>Non custom led select.  Following EEE spec, combine the Link signal and LPI signal in the same LED pin. While entering LPI state, LED will blink with  2784ms cycle, of which the first  2349ms LED light is turned off, after  435ms is turned on.  
NO EEE in RL6166.</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Ledsel3</name>
              <description>Custom led3 select.</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Ledsel2</name>
              <description>Custom led2 select.</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Ledsel1</name>
              <description>Custom led1 select.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Ledsel0</name>
              <description>Custom led0 select.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BIST</name>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>csr_rff_tmck</name>
              <description>Set TMCK for RXFIFO</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_rff_nap</name>
              <description>Set NAP for RXFIFO</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_rff_dvse</name>
              <description>Set DVSE for RXFIFO</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_rff_dvs</name>
              <description>Set DVS for RXFIFO</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_tff_tmck</name>
              <description>Set TMCK for TXFIFO</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_tff_nap</name>
              <description>Set NAP for TXFIFO</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_tff_dvse</name>
              <description>Set DVSE for TXFIFO</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>csr_tff_dvs</name>
              <description>Set DVS for TXFIFO</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PGLBK</name>
          <addressOffset>0x00000084</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>en_pglbk</name>
              <description>Enable packet generator mode</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pglbk_data_pat_sel</name>
              <description>1: fixed pattern, 0: pseudo random</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pglbk_done</name>
              <description>packet generator in wire lbk mode status. 1: done</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>pglbk_fail</name>
              <description>packet generator in wire lbk mode status. 1: fail</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>pblbk_pkt_length_sel</name>
              <description>0: random (range: 64-1504B), 1: 64B</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pglbk_pkt_num_sel</name>
              <description>2'b00: 100 pkts,  
2'b10: 5 pkts. 
2'b01: 1 pkt 
2'b11: reserved.</description>
              <bitRange>[10:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>R_disable_txcrc</name>
              <description>1: not append CRC for egress packet. 
0: append CRC for egress packet.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>pglbk_data_pat</name>
              <description>Pattern inside tx packet when pglbk_data_pat_sel is high. For RLE0516, only pglbk_data_pat[3:0] are used.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_CR1</name>
          <addressOffset>0x00000088</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EN_FRC_EEE</name>
              <description>Enable EEE force mode 
0: Disable EEE FORCE Mode 
1: Enable EEE FORCE Mode If EN_FRC_EEE=1, both FRC_EEE_Giga and FRC_EEE_100 are used to force MAC operation ability.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FRC_EEE_Giga</name>
              <description>If EN_FRC_EEE=1, FRC_EEE_Giga:  
0: Disable MAC EEE ability for 1000BASE-T. 
1: Enable MAC EEE ability for 1000BASE-T. If EN_FRC_EEE=0, FRC_EEE_Giga means EEE advertisement register 7.60 bit[2]</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FRC_EEE</name>
              <description>If EN_FRC_EEE=1, FRC_EEE_100 
0: Disable MAC EEE ability for 100BASE-TX. 
1: Enable MAC EEE ability for 100BASE-TX. If EN_FRC_EEE=0, FRC_EEE_100 means EEE advertisement register 7.60 bit[1]</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_EEE</name>
              <description>Set same as PHY setting, for LED.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_EEE_TX</name>
              <description>Enable MAC TX EEE ability 
0: Disable EEE ability for TX. 
1: Enable EEE ability for TX.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EN_EEE_RX</name>
              <description>Enable MAC RX EEE ability 
0: Disable EEE ability for RX.  
1: Enable EEE ability for RX. Application note : The following methods could be used to disable EEE function.    a) n[1:0] = 00 -&gt; completely disable EEE function, or    b) n[3:2] = 00 -&gt; disable /1000Mbps EEE  capability (excludes 10Mbps ).</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Eee_outq_lowq_over</name>
              <description>SW has many packets to be tranmitted, then set this bit to tell HW leave lpi state in condition2.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_STS</name>
              <description>Indicate EEE status, both TX and RX. 
1: Both TX and RX in LPI mode simultaneously. 
0: not both TX and RX in LPI mode simultaneously</description>
              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EEE_TX_STS</name>
              <description>Indicate EEE TX status 
1: TX is in LPI mode.  
0: TX is in normal mode.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EEE_RX_STS</name>
              <description>Indicate Port 0 EEE RX status  
1: RX is in LPI mode.  
0: RX is in normal mode.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EEE_PauseFlag</name>
              <description>Set indication for LPI request due to RX pause on frame. 
1: indicate RX pause on frame;
0: no indicate.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>EEE_Wake_Set1</name>
              <description>Enable LPI TX high priority pkt Wakeup decision maker for EEE. 
1: enable;
0: disable. Gmac will leave lpi mode when EEE_CR1_reg.txq_th is met or one of the egress is larger than 512B.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Wake_Set0</name>
              <description>Enable LPI TX transmit wakeup decision maker for EEE. 
1: enable;
0: disable.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Req_Set2</name>
              <description>Enable LPI TX request RX pause on frame decision maker for EEE. 
1: enable;
0: disable.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Req_Set1</name>
              <description>Enable LPI TX request queue empty decision maker for EEE. 
1: enable;
0: disable. For RLE0390(原RL6166), only for tx is single descriptor operation. For next version, this bit can support multi-descriptor operation.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Req_Set0</name>
              <description>Enable LPI TX request Rate decision maker for EEE. 
1: enable;
0: disable.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_RXTimer_EN</name>
              <description>Enable RX meter to count RX LPI status time</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_TXTimer_EN</name>
              <description>Enable TX meter to count TX LPI status time</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Unit_Giga_1</name>
              <description>Set the unit for timer T_wakeup, T_tx_rate, and T_pause in EEE function. 
00: 1uS; 
01: 16 uS; 
10: 128 uS; 
11: 1024uS.</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Unit_Giga_2</name>
              <description>Set the unit for timer T_tx_delay in EEE function. 
00: 8uS; 
01: 64uS; 
10: 256uS; 
11: 1024uS.</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Unit_100_1</name>
              <description>Set the unit for timer T_wakeup, T_tx_rate, and T_pause in EEE function. 
00: 1uS; 
01: 16uS; 
10: 128uS; 
11: 1024uS.</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Unit_100_2</name>
              <description>Set the unit for timer T_tx_delay in EEE function. 
00: 8uS; 
01: 64uS; 
10: 512uS; 
11: 1024uS.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_CR2</name>
          <addressOffset>0x0000008C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x100AC40A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EEE_Timer_Tw_Giga</name>
              <description>Timer value in EEE function for T_wakeup. Value from 0~256.
Unit: EEE_Timer_Unit_Giga_1.
Default value is 16 us.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Tr_Giga</name>
              <description>Timer value in EEE function for T_tx_rate.
Unit: EEE_Timer_Unit_Giga_1.
Default value is 10 us.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Td_Giga</name>
              <description>Timer value in EEE function for QoS based LPI decision maker T_tx_delay.
Unit: EEE_Timer_Unit_Giga_2*4.
Default value is 200  ms.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Tp_Giga</name>
              <description>Timer value in EEE function for TX decision maker T_pause.
Unit: EEE_Timer_Unit_Giga_1.
Default value is 10 us.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_CR3</name>
          <addressOffset>0x00000090</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x1E0AF40A</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EEE_Timer_Tw_100</name>
              <description>Timer value in EEE function for T_wakeup. Value from 0~256.
Unit: EEE_Timer_Unit_100_1
Default value is 30 us.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Tr_100</name>
              <description>Timer value in EEE function for T_tx_rate.
Unit: EEE_Timer_Unit_100_1.
Default value is 10 us.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Td_100</name>
              <description>Timer value in EEE function for QoS based LPI decision maker T_tx_delay.
Unit: EEE_Timer_Unit_100_2*4.
Default value is 1s.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_Timer_Tp_100</name>
              <description>Timer value in EEE function for TX decision maker T_pause.
Unit: EEE_Timer_Unit_100_1.
Default value is 10 us.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_CR4</name>
          <addressOffset>0x00000094</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x0271003E</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EEE_TX_THR_Giga</name>
              <description>Set the TX threshold in EEE function. Unit is Byte. EEE_TX_THR=Round [(T_tx_rate*Rate) / 8 ]. If you set T_tx_rate=10us, Rate=1000Mbps, so set EEE_TX_THR =  0x4E2 (1250bytes).
Default value is 0x271(~half rate).</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_TX_THR_100</name>
              <description>Set the TX threshold in EEE function. Unit is Byte. EEE_TX_THR=Round [(T_tx_rate*Rate) / 8 ]. If you set T_tx_rate=10us, Rate=100Mbps, so set EEE_TX_THR = 0x7D (125bytes).
Default value is 0x3E (~half rate).</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_LPI_TMO_REG</name>
          <addressOffset>0x00000098</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EEE_RXLPI_Time</name>
              <description>RX in LPI time. (unit: 1us) (accumulation)Valid as (PORT_MASK[0]==1&amp;&amp;RXTimer_EN==1)</description>
              <bitRange>[21:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEE_LPI_TM1_REG</name>
          <addressOffset>0x0000009C</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>eee_stop_txc</name>
              <description>This bit works in rgmii_1000 and rgmii_100 modes only. 
1: gmac halts gmac_rgmii_txc_out when gmac enters lpi. 
0: gmac does not halt gmac_rgmii_txc_out when gmac enters lpi. This bit should always be b0 for RLE0390(原RL6166). Gmac can halt gmac_rgmii_txc_out in the next version.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>eee_trxctl_level</name>
              <description>The gmac_rgmii_txe and gmac_rgmii_rxdv level when gmac is in lpi.  
1: tx_ctl and rx_ctl is high when in lpi. 
0: reserved.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>EEE_TXLPI_Time</name>
              <description>TX in LPI time. (unit: 1us ) (accumulation)Valid as (PORT_MASK[0]==1&amp;&amp;TXTimer_EN==1)</description>
              <bitRange>[21:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEEP_CR1</name>
          <addressOffset>0x000000B0</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>En_EEEP</name>
              <description>Enable EEEP function 0b0: Disable EEEP function.  0b1: Enable EEEP function.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_EN_EEEP_RX</name>
              <description>1: Enable EEEP RX.
0: Disable EEEP RX.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_EN_EEEP_TX</name>
              <description>1: Enable EEEP TX.
0: Disable EEEP TX.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_EN_EEEP_GIGA</name>
              <description>1: Enable EEEP in giga mode.
0: Disable EEEP in giga mode.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_EN_EEEP</name>
              <description>1: Enable EEEP in  mode.
0: Disable EEEP in  mode.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CFG_EEEP_DEFER_TXLPI</name>
              <description>???</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PHY_MST_MODE</name>
              <description>When PMA is in master clock role, the EEEP_RX can work. SW needs to configure PCS reg9.bit12(Master-slave manual config enable) and reg9.bit11(Master-slave config value). Then setting EEEP_CR1_REG.PHY_MST_MODE.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>Eeep_dbgo_sel</name>
              <description>eeep module debug signals selection.</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EEEP_CR2</name>
          <addressOffset>0x000000B4</addressOffset>
          <size>32</size>
          <description></description>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EEEP_Sleep_Step</name>
              <description>Value from 1 to 255, indicate the rx sleep step in EEEP function. Value 0 is the same as 1. EEPROM and register configurable.//???</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
