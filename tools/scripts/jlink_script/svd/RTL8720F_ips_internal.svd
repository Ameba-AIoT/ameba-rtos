          <description>Error code register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_CODE</name>
              <description>The error code of error request, if it's 0, indicates that there is no error request. 
8'h00: No error
8'h01: Address hole error   
8'h2C: AXI master agent wdata timeout
8'h2D: AXI master agent write response timeout     
8'h2E: AXI master agent write response timeout   
8'h30: AXI SRAM controller grant timeout     
8'h38: AXI slave agent arready timeout 
8'h39: AXI slave agent rvalid timeout    
8'h3A: AXI slave agent arready timeout 
8'h3B: AXI slave agent wready timeout 
8'h3C: AXI slave agent bvalid timeout</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ELR_INTR_CLR</name>
          <addressOffset>0x0000113C</addressOffset>
          <size>32</size>
          <description>Error log clear register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELR_INTR_CLR</name>
              <description>Error log interrupt clear. Writing 1'b1 to the register will trigger a 1-cycle pulse interrupt clear. It has to write 1'b1 to this register every time when the error exception occurs.
Note that this register is write-only, the return value of reading this register is meaningless.</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_GUARD_EN</name>
          <addressOffset>0x00001300</addressOffset>
          <size>32</size>
          <description>Timeout guardian enable register</description>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GUARDIAN_MODE_EN_PLFM1_SLV</name>
              <description>The enable of platform1 slave timeout monitor                                                                                                                                  
0x0: Disable timeout check 
0x1: Enable timeoute check</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GUARDIAN_MODE_EN_WIFI</name>
              <description>The enable of WIFI timeout monitor                                                                                                                                  
0x0: Disable timeout check 
0x1: Enable timeoute check</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GUARDIAN_MODE_EN_PLFM1_MST</name>
              <description>The enable of SIC/OTPC/ARS_SHA/GDMA timeout monitor                                                                                                                                  
0x0: Disable timeout check 
0x1: Enable timeoute check</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GUARDIAN_MODE_EN_KM4NS</name>
              <description>The enable of KM4NS timeout monitor                                                                                                                                  
0x0: Disable timeout check 
0x0: Enable timeoute check</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GUARDIAN_MODE_EN_SRAMC</name>
              <description>The enable of SRAMC timeout monitor                                                                                                                                  
0x0: Disable timeout check 
0x1: Enable timeoute check</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_CLEAN_N</name>
          <addressOffset>0x00001340</addressOffset>
          <size>32</size>
          <description>Timeout clear register</description>
          <resetValue>0x0000001F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TMO_CLEAR_N_PLFM1_SLV</name>
              <description>The register can only written to 0 when a platform1 time out occures, and automatically clear this register by hardware</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_WIFI</name>
              <description>The register can only written to 0 when a WIFI time out occures, and automatically clear this register by hardware</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_PLFM1_MST</name>
              <description>The register can only written to 0 when a SIC/OTPC/ARS_SHA/GDMA time out occures, and automatically clear this register by hardware</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_KM4NS</name>
              <description>The register can only written to 0 when a KM4NS time out occures, and automatically clear this register by hardware</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TMO_CLEAR_N_SRAMC</name>
              <description>The register can only written to 0 when a SRAMC time out occures, and automatically clear this register by hardware</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG0</name>
          <addressOffset>0x00001380</addressOffset>
          <size>32</size>
          <description>Timeout monitor configuration register0</description>
          <resetValue>0x000F00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRADE</name>
              <description>Timeout grade                                                                                                                                                                                                                                      Timeout total cycle = [256*(2^(grade-1) +1)*threshold] - inaccurate                                                                                                       Note1: the range of inaccurate = 0 ~ [256*(2^(grade-1) +1)-2]                                                                                              Note2: If threshold is 0x0, the Timeout_total_cycle is always 1</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>THRESHOLD</name>
              <description>Timeout threshold</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIMEOUT_MON_CFG1</name>
          <addressOffset>0x00001384</addressOffset>
          <size>32</size>
          <description>Timeout monitor configuration register0</description>
          <resetValue>0x000F00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRADE</name>
              <description>Timeout grade                                                                                                                                                                                                                                      Timeout total cycle = [256*(2^(grade-1) +1)*threshold] - inaccurate                                                                                                       Note1: the range of inaccurate = 0 ~ [256*(2^(grade-1) +1)-2]                                                                                              Note2: If threshold is 0x0, the Timeout_total_cycle is always 1</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>THRESHOLD</name>
              <description>Timeout threshold</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
