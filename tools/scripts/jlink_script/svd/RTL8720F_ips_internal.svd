              <access>read-write</access>
            </field>
            <field>
              <name>INPUT_LAYER1_PIX_SRC</name>
              <description>Pixel source:
0x0: CONST_PIX
0x1: DMA (read from memory)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INPUT_LAYER1_FORMAT</name>
              <description>Format of pixels from memory</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
