              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>THRESHOLD</name>
              <description>Timeout threshold</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
