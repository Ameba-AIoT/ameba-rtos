            </field>
            <field>
              <name>iv_swap_disable</name>
              <description>1: disable swap iv_x</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>cpu_data_swap_disable</name>
              <description>1: disable swap cpu_datain_x and cpu_dataout_x</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
