menu "CONFIG LWIP"
    config FAST_DHCP_MENU
        bool "Enable Fast DHCP"
        select FAST_DHCP if WHC_HOST || WHC_NONE

    config RNAT_MENU
        bool "Enable R-NAT"
        select RNAT if WHC_HOST || WHC_NONE

    config LWIP_IPV6_MENU
        bool "Enable LWIP IPV6"
        select LWIP_IPV6 if WHC_HOST || WHC_NONE

    config LWIP_SKIP_CHECK_UDP_CHECKSUM
        bool "Skip check UDP checksum"
        help
            Skip checksum for UDP RX packet
            Skipping it will provide higher throughput but reduce reliability.

    config USB_ETHERNET_PROVIDER
        bool
    config USB_ETHERNET_BRIDGE_PROVIDER
        bool

    config LWIP_USB_ETHERNET_MENU
        bool "Enable LWIP USB ETHERNET"
        depends on USB_ETHERNET_PROVIDER
        default y
        select LWIP_USB_ETHERNET if WHC_HOST || WHC_NONE

    config LWIP_USB_ETHERNET_BRIDGE_MENU
        bool "Enable LWIP USB ETHERNET BRIDGE"
        depends on USB_ETHERNET_BRIDGE_PROVIDER
        default y
        select LWIP_USB_ETHERNET_BRIDGE if WHC_HOST || WHC_NONE

    config LWIP_USB_ETHERNET
        bool

    config LWIP_USB_ETHERNET_BRIDGE
        bool

    config LWIP_ETHERNET
        depends on ETHERNET
        bool "Enable LWIP ETHERNET"

    config FAST_DHCP
        bool
    config RNAT
        bool
    config LWIP_IPV6
        bool

    config LWIP_DEBUG
        bool "Enable LWIP Debug"
        default n

    config LWIP_STATS
        bool "Enable LWIP Stats"
        default n

    if LWIP_DEBUG
