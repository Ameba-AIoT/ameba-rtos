comment "----------CPU config----------"

menu "CONFIG Chip Arch"
    # Adding the suffix _FOR_KM55NS is not allowed here
endmenu

menu "CONFIG CHIP"
    choice
        prompt "ArmCore"
        default ARM_CORE_CM4_KM4NS_FOR_KM55NS
        config ARM_CORE_CM4_KM4NS_FOR_KM55NS
            bool "ARM_CM4_KM4NS (KM55NS)"
            help
              KM55 is compatible with the previous KM4 core, so the KM4 core macro
              CONFIG_ARM_CORE_CM4_KM4NS is still used here.
    endchoice

    config ARM_CORE_CM4_FOR_KM55NS
        bool
        default y

    choice
        prompt "Chip Version"
        default RTL8720F_A_CUT_FOR_KM55NS
        config RTL8720F_A_CUT_FOR_KM55NS
            bool "RTL8720F_A_Cut"
    endchoice
endmenu
