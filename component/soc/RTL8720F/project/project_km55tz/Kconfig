comment "----------CPU config----------"

menu "CONFIG CHIP"
    choice
        prompt "ArmCore"
        default ARM_CORE_CM4_KM4TZ_FOR_KM55TZ
        config ARM_CORE_CM4_KM4TZ_FOR_KM55TZ
            bool "ARM_CM4_KM4TZ (KM55TZ)"
            help
              KM55 is compatible with the previous KM4 core, so the KM4 core macro
              CONFIG_ARM_CORE_CM4_KM4TZ is still used here.
    endchoice

    config ARM_CORE_CM4_FOR_KM55TZ
        bool
        default y

    choice
        prompt "Chip Version"
        default RTL8720F_A_CUT_FOR_KM55TZ
        config RTL8720F_A_CUT_FOR_KM55TZ
            bool "RTL8720F_A_Cut"
    endchoice

    config CPU_HAS_FPU_FOR_KM55TZ
        bool
        default y
endmenu


