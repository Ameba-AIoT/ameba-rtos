menu "CONFIG User Config"

menu "Flash Layout Configuration"

# Boot Manifest(4K) + KM4 Bootloader(252K)
comment "BOOT Offset: 0x8000000 (fixed)"

config FLASH_BOOT_OFFSET
    hex
    default 0x8000000

config FLASH_BOOT_SIZE
    hex "BOOT Size"
    default 0x14000

# Certificate(4K) + Manifest(4K) + KM0 & KM4 & CA32 Application OTA1 + RDP IMG OTA1
config FLASH_OTA1_OFFSET
    hex "APP OTA1 Offset"
    default 0x8014000

config FLASH_OTA1_SIZE
    hex "APP OTA1 Size"
    default 0x1EC000

# Boot Manifest(4K) + KM4 Bootloader(252K) OTA
config FLASH_BOOT_OTA2_OFFSET
    hex "BOOT OTA2 Offset"
    default 0x8200000

config FLASH_BOOT_OTA2_SIZE
    hex "BOOT OTA2 Size"
    default 0x14000

# Certificate(4K) + Manifest(4K) + KM0 & KM4 & CA32 Application OTA2 + RDP IMG OTA2
config FLASH_OTA2_OFFSET
    hex "APP OTA2 Offset"
    default 0x8214000

config FLASH_OTA2_SIZE
    hex "APP OTA2 Size"
    default 0x1C9000

# VFS region 1 (512K)
config FLASH_VFS1_OFFSET
    hex "VFS1 Offset"
    default 0x083E0000

config FLASH_VFS1_SIZE
    hex "VFS1 Size"
    default 0x20000

# Manifest(4K) + DSP IMG
config FLASH_DSP_OFFSET
    hex "DSP Offset"
    depends on DSP_EN && !DSP_WITHIN_APP_IMG
    default 0x08400000

config FLASH_DSP_SIZE
    hex "DSP Size"
    depends on DSP_EN && !DSP_WITHIN_APP_IMG
    default 0x300000

# VFS region 2
config FLASH_VFS2_OFFSET
    hex "VFS2 Offset"
    default 0xFFFFFFFF

config FLASH_VFS2_SIZE
    hex "VFS2 Size"
    default 0

# reserve for user
config FLASH_USER_OFFSET
    hex "USER Offset"
    default 0xFFFFFFFF

config FLASH_USER_SIZE
    hex "USER Size"
    default 0

endmenu

menu "Boot Configuration"

config LOGUART_AGG_EN
    bool "Enable Loguart AGG"
    default n
    help
        Enable or disable Loguart log aggregation (Boot_Agg_En).
        If the output character sequence of the serial port tool is
        disordered, enable this option according to the chip ID.

endmenu

menu "Clock Configuration"

choice
    prompt "SoC Clock Config"
    default CLKCFG_AUTO
    help
        Select the SoC clock configuration. AUTO (CONFIG_CLKCFG_IDX 0xFF) lets the
        bootloader pick the clock/voltage level at runtime according to the PSRAM
        clock limit (recommended). For the fixed levels, the leading [N] is the
        index into SocClk_Info[] in ameba_bootcfg.c.

config CLKCFG_AUTO
    bool "[auto] Auto by PSRAM clock (0xFF)"

config CLKCFG_0P9_PSRAM166
    bool "[0] 0.9V, PSRAM 166MHz"

config CLKCFG_1P0_PSRAM166
    bool "[1] 1.0V, PSRAM 166MHz"

config CLKCFG_1P0_PSRAM200
    bool "[2] 1.0V, PSRAM 200MHz"

config CLKCFG_1P0_PSRAM250
    bool "[3] 1.0V, PSRAM 250MHz"

endchoice

config CLKCFG_IDX
    int
    default 0 if CLKCFG_0P9_PSRAM166
    default 1 if CLKCFG_1P0_PSRAM166
    default 2 if CLKCFG_1P0_PSRAM200
    default 3 if CLKCFG_1P0_PSRAM250
    default 255

endmenu

menu "RAM Layout Configuration"

# SRAM top the images are linked against: 512K parts end at 0x20080000, 768K parts at 0x200C0000.
config SRAM_END
    hex "SRAM end address"
    depends on !DSP_EN && DATA_HEAP_SRAM
    range 0x20080000 0x200C0000
    default 0x20080000
    help
        Set to the SRAM top of the part in use (4K aligned): 0x20080000 for 512K, up to
        0x200C0000 for 768K. The extra space grows the elastic image2 region (KM4 as WHC
        host / single core, else KR4) for sections and its tail heap. The bootloader checks
        the setting against the real SRAM top and warns when it does not match.

# TrustZone secure image (Image3) size. For SoCs without PSRAM this region may
# live in SRAM, so it is a general RAM-layout parameter, configured per IC.
config TZ_S_SIZE
    int "TrustZone Secure Image Size (KB)"
    depends on TRUSTZONE
    default 128 if TRUSTZONE_MBEDTLS
    default 64
    help
        Size of TrustZone secure image (Image3) in KB.
        Default 64KB, or 128KB when MbedTLS is enabled.

# KR4(NP core) PSRAM image2 region size, in KB. Fixed segment right after TZ.
config PSRAM_KR4_IMG2_KB
    int "KR4 PSRAM image2 size (KB)"
    depends on IMG2_PSRAM || DATA_HEAP_PSRAM
    range 64 8192
    default 1536
    help
        Size of the KR4 (NP core) PSRAM image2 region in KB. KR4 sits right
        after the TrustZone region and does not move when KM4/DSP are resized.

# KM4(AP core) PSRAM image2 region size, in KB. Only meaningful when DSP is on
# (DSP takes the remainder up to PSRAM_END). When DSP is off, KM4 absorbs the
# remainder itself and this value is ignored.
config PSRAM_KM4_IMG2_KB
    int "KM4 PSRAM image2 size (KB)"
    depends on (IMG2_PSRAM || DATA_HEAP_PSRAM) && DSP_EN
    range 64 8192
    default 1536
    help
        Size of the KM4 (AP core) PSRAM image2 region in KB, including the
        TrustZone slice carved from it. Only used when DSP is enabled; with DSP
        off, KM4 extends to the runtime PSRAM top instead.

# SRAM image2 budgets. Which core takes its budget and which one absorbs the SRAM
# remainder depends on the layout variant, see the IMG2 Size block in
# ameba_layout.ld. Both budgets apply with the DSP in SRAM; otherwise only the
# budget of the core that does not absorb the remainder is used.
config SRAM_KM4_IMG2_KB
    int "KM4 SRAM image2 size (KB)"
    depends on DSP_RUN_IN_SRAM || (!(DSP_EN && DATA_HEAP_PSRAM) && !WHC_HOST_FOR_KM4 && !WHC_NONE_FOR_KM4)
    range 32 448
    default 96
    help
        Size of the KM4 SRAM image2 region in KB. Applies when the DSP runs from
        SRAM (KM4 -> KR4 -> DSP tail), and when KR4 absorbs the SRAM remainder
        (KM4 fixed right after the TrustZone region). Must hold the KM4
        SRAM-resident sections (.sram.*, and .data/.bss when DATA_HEAP_SRAM), what
        is left becomes the KM4 heap.

config SRAM_KR4_IMG2_KB
    int "KR4 SRAM image2 size (KB)"
    depends on DSP_RUN_IN_SRAM || (!(DSP_EN && DATA_HEAP_PSRAM) && (WHC_HOST_FOR_KM4 || WHC_NONE_FOR_KM4))
    range 32 448
    default 96
    help
        Size of the KR4 SRAM image2 region in KB. Applies when the DSP runs from
        SRAM (placed right after KM4), and when KM4 absorbs the SRAM remainder
        (KR4 pinned at the SRAM_END side). Must hold the KR4 SRAM-resident
        sections, what is left becomes the KR4 heap.

endmenu

endmenu
