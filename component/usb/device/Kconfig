comment "USB Device Global Settings"

config USBD_COMPOSITE_MENU
    bool "Composite functions enable"
    select USBD_COMPOSITE if WHC_HOST || WHC_NONE
    help
      Composite Device — combine multiple class functions into one USB device.
      Select one or more class options below to build together.

config USBD_SELF_POWERED
    bool "Self-powered device"
    default n
    help
      Set bmAttributes bit 6 (Self-powered) in Configuration Descriptor
      and GET_STATUS response.

      If not selected, the device defaults to bus-powered mode.

config USBD_REMOTE_WAKEUP_EN
    bool "Remote wakeup enable"
    default n
    help
      Set bmAttributes bit 5 (Remote Wakeup) in Configuration Descriptor.
      When enabled, the device can signal remote wakeup to the host.

comment "USB Device Class Selection"

config USBD_CDC_ACM_MENU
    bool "CDC ACM"
    select USBD_CDC_ACM if WHC_HOST || WHC_NONE

config USBD_CDC_ECM_MENU
    bool "CDC ECM"
    select USBD_CDC_ECM if WHC_HOST || WHC_NONE
    select USB_ETHERNET_PROVIDER

config USBD_CDC_NCM_MENU
    bool "CDC NCM"
    select USBD_CDC_NCM if WHC_HOST || WHC_NONE
    select USB_ETHERNET_PROVIDER

    if USBD_CDC_NCM_MENU
        config USBD_CDC_NCM_TX_AGGREGATION
            bool "Enable NCM TX aggregation"
            default n
    endif

config USBD_HID_MENU
    bool "HID"
    select USBD_HID if WHC_HOST || WHC_NONE
    if USBD_HID_MENU
        choice
            prompt "Select HID device type"
            default USBD_HID_MOUSE
            config USBD_HID_MOUSE
                bool "Mouse"
            config USBD_HID_KEYBOARD
                bool "Keyboard"
        endchoice
    endif

config USBD_INIC_MENU
    bool "INIC"
    depends on SUPPORT_USBD_INIC
    select USBD_INIC if WHC_HOST || WHC_NONE

config USBD_MSC_MENU
    bool "MSC"
    select USBD_MSC if WHC_HOST || WHC_NONE
    if USBD_MSC_MENU
        choice
            prompt "Select storage media"
            default USBD_MSC_SD_MODE
            config USBD_MSC_RAM_DISK
                bool "RAM"
            config USBD_MSC_SD_MODE
                bool "SD Card (SD mode)"
                depends on SUPPORT_SDIOH
                select VFS_FATFS_INCLUDED if WHC_HOST || WHC_NONE
                select FATFS_SD_MODE if WHC_HOST || WHC_NONE
            config USBD_MSC_SECOND_FLASH
                bool "Second FLASH"
                depends on SUPPORT_USBD_MSC_SECOND_FLASH
                select VFS_FATFS_INCLUDED if WHC_HOST || WHC_NONE
                select FATFS_SECOND_FLASH if WHC_HOST || WHC_NONE
        endchoice
    endif

config USBD_UAC_MENU
    bool "UAC"
    depends on SUPPORT_USBD_UAC
    select USBD_UAC if WHC_HOST || WHC_NONE
    select AUDIO_FWK_MENU if SUPPORT_AUDIO_FOR_USB
    choice
        prompt "Select UAC Version"
        depends on USBD_UAC_MENU
        config USBD_UAC1_MENU
            bool "UAC 1.0"
            select USBD_UAC1 if WHC_HOST || WHC_NONE
        config USBD_UAC2_MENU
            bool "UAC 2.0"
            select USBD_UAC2 if WHC_HOST || WHC_NONE
    endchoice

config USBD_VENDOR_MENU
    bool "VENDOR"
    select USBD_VENDOR if WHC_HOST || WHC_NONE

config USBD_DFU_MENU
    bool "DFU"
    select USBD_DFU if WHC_HOST || WHC_NONE

config USBD_UVC_MENU
    bool "UVC"
    depends on SUPPORT_USBD_UVC
    select USBD_UVC if WHC_HOST || WHC_NONE

